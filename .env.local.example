# ---------------------------------------------------------------------------
# Speech-to-Text Studio — environment template
#
#   1. Copy this file to `.env.local`        (cp .env.local.example .env.local)
#   2. Paste your keys below — ONLY the ones you want to change
#   3. Restart `npm run dev` (Next.js only reads env files on boot)
#
# Every engine already ships with a built-in default key, so the app works
# with this file left exactly as it is. A variable set here replaces the
# default for that engine and nothing else; leave a line empty to keep using
# the built-in one.
#
# To run on your own keys only, set DISABLE_BUILTIN_KEYS=1 below as well.
#
# `.env.local` is git-ignored. Never put real keys in this example file and
# never expose them with a NEXT_PUBLIC_ prefix — the browser calls
# `/api/transcribe` and the server attaches the keys.
# ---------------------------------------------------------------------------

# --- Primary engine: Deepgram (Nova-2) -------------------------------------
# Get a key: https://console.deepgram.com/signup  →  API Keys
# Also accepts `DEEPGRAM_KEY` / `DG_API_KEY` as aliases.
# On Vercel: Project → Settings → Environment Variables (or `vercel env pull`).
DEEPGRAM_API_KEY=
#   (leave empty to use the built-in default key for this engine)

# --- Fallback engine: Gladia -------------------------------------------------
# Get a key: https://app.gladia.io/  →  Settings → API keys
# Also accepts `GLADIA_KEY` as an alias.
GLADIA_API_KEY=
#   (leave empty to use the built-in default key for this engine)

# --- Fallback engine 2: AssemblyAI ------------------------------------------
# Get a key: https://www.assemblyai.com/dashboard/  →  API keys
# (activate the account first: https://www.assemblyai.com/dashboard/activation)
# Also accepts `ASSEMBLYAI_KEY` / `AAI_API_KEY`.
# Async API: the route uploads the audio, creates a transcript, then polls it.
ASSEMBLYAI_API_KEY=
#   (leave empty to use the built-in default key for this engine)

# --- Fallback engine 3: Speechmatics ----------------------------------------
# Get a key: https://portal.speechmatics.com/  →  your project → API keys
# Also accepts `SPEECHMATICS_KEY` / `SM_API_KEY`.
# Region matters: a key issued for one region is rejected by another. The
# default is the EU host — US accounts should point the base URL at
# https://us1.asr.api.speechmatics.com/v2
SPEECHMATICS_API_KEY=
#   (leave empty to use the built-in default key for this engine)



# ---------------------------------------------------------------------------
# Interface (nothing to configure)
# ---------------------------------------------------------------------------
# Language and theme are per-visitor cookies, not environment variables:
#
#   stt_locale=en | ar                     (falls back to Accept-Language, then en)
#   stt_theme=system | light | dark        (system follows prefers-color-scheme)
#
# The web manifest is generated per request from the same two cookies, so an
# Arabic visitor who prefers light mode installs an Arabic, light-themed app.


# Keys can also be supplied by a visitor, without touching this file: the
# settings page (/settings) stores a personal key in an httpOnly cookie on the
# visitor's own device, and that key takes precedence over everything else.
#
# The full order, per engine:
#
#   1. a key saved in /settings   (this browser, removable, wins outright)
#   2. the variable below         (this deployment)
#   3. the built-in default in lib/server/default-keys.js
#
# Set DISABLE_BUILTIN_KEYS=1 to drop tier 3 and run on tiers 1 and 2 alone.
# DISABLE_BUILTIN_KEYS=


# ---------------------------------------------------------------------------
# Failover order
# ---------------------------------------------------------------------------
# The order engines are tried in for `engine=auto`, and the order the remaining
# engines are tried in after a fallback-worthy failure. Omit any engine you do
# not want to use; unknown ids are appended rather than silently disabling an
# engine, so a typo can never leave you with no engine at all.
# ENGINE_ORDER=assemblyai,deepgram,gladia,speechmatics


# ---------------------------------------------------------------------------
# Vercel deployment
# ---------------------------------------------------------------------------
#
# Vercel caps a serverless request body at 4.5 MB, which no audio app can live
# with. Connect a Blob store to unlock large files:
#
#   Vercel dashboard → your project → Storage → Create → Blob
#   (tick Production, Preview *and* Development, then run `vercel env pull`)
#
# That injects BLOB_READ_WRITE_TOKEN below. Once it is present, the browser
# uploads anything above MAX_UPLOAD_MB straight to Blob storage, the API route
# hands Deepgram/Gladia the resulting URL, and the object is deleted as soon as
# transcription finishes. Without it, uploads are limited to 4 MB.
BLOB_READ_WRITE_TOKEN=

# Largest file a browser may upload to the store, in megabytes.
# BLOB_MAX_UPLOAD_MB=200

# Set to `false` to keep uploaded audio in the store after transcription
# (not recommended — the default deletion is what makes "nothing is stored" true).
# BLOB_DELETE_AFTER_USE=true

# Set to `false` to disable the large-file path entirely.
# ALLOW_BLOB_UPLOAD=true

# Wall-clock budget for provider work inside one function invocation, in
# milliseconds. Defaults to 55s on Vercel (maxDuration is 60) and 120s when
# self-hosted. Every provider timeout is clamped to fit inside it, so the route
# returns a real JSON error instead of being killed mid-request.
# FUNCTION_BUDGET_MS=55000


# ---------------------------------------------------------------------------
# Optional tuning — every value below has a safe default. Delete freely.
# ---------------------------------------------------------------------------

# Model used by the primary engine. `nova-2` is the documented default.
# Switch to `nova-3` for broader language coverage (e.g. Arabic).
# DEEPGRAM_MODEL=nova-2

# AssemblyAI model. Leave unset to use your account default (recommended — a
# stale model id is rejected with a 400). Current ids: universal-3-pro, universal-2
# ASSEMBLYAI_MODEL=

# Speechmatics model: standard | enhanced | melia-1
# SPEECHMATICS_MODEL=enhanced

# Server-side abort timeout per provider request, in milliseconds.
# Every value is clamped to FUNCTION_BUDGET_MS, so a slow provider degrades
# into a clean error instead of a killed serverless function.
# DEEPGRAM_TIMEOUT_MS=120000
# GLADIA_TIMEOUT_MS=120000
# ASSEMBLYAI_TIMEOUT_MS=120000
# SPEECHMATICS_TIMEOUT_MS=120000

# Optional endpoint overrides — useful for a corporate gateway, a proxy, or a
# local mock server (`npm run demo`). Leave unset to use the public APIs.
# DEEPGRAM_BASE_URL=https://api.deepgram.com/v1/listen
# GLADIA_BASE_URL=https://api.gladia.io/v2
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com/v2
# SPEECHMATICS_BASE_URL=https://eu1.asr.api.speechmatics.com/v2

# How long to poll an async job before giving up, in milliseconds.
# GLADIA_POLL_TIMEOUT_MS=120000
# GLADIA_POLL_INTERVAL_MS=2000
# ASSEMBLYAI_POLL_TIMEOUT_MS=120000
# ASSEMBLYAI_POLL_INTERVAL_MS=2000
# SPEECHMATICS_POLL_TIMEOUT_MS=120000
# SPEECHMATICS_POLL_INTERVAL_MS=2000

# Hard cap on audio sent *through* the API route, in megabytes. Defaults to 4
# on Vercel (the platform body limit is 4.5 MB) and 25 when self-hosted.
# MAX_UPLOAD_MB=4

# Best-effort in-memory rate limit, per client IP.
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_SEC=60

# Set to `false` to stop the fallback engine from stepping in when the primary
# engine returns an empty (but successful) transcript.
# FALLBACK_ON_EMPTY_TRANSCRIPT=false

# Set to `false` to remove the in-UI "allow automatic fallback" switch, forcing
# fallback to always be available to API callers.
# ALLOW_CLIENT_FALLBACK_OPTION=true


# ---------------------------------------------------------------------------
# Usage & remaining-limit panel
# ---------------------------------------------------------------------------
#
# The studio shows what this app has consumed per engine, plus whatever each
# provider is willing to report through its API:
#
#   Deepgram      remaining balance + audio hours  (management API)
#   Speechmatics  batch hours + job counts         (usage API)
#   Gladia        dashboard only  → local counters
#   AssemblyAI    dashboard only  → local counters
#
# Nothing is estimated: a card that has no provider figure says so instead of
# showing a made-up number.
#
# `DEEPGRAM_BALANCE_ID` is only needed if the key has several balances and the
# management API refuses to list them; the balance total is summed when the
# list call succeeds.
# DEEPGRAM_BALANCE_ID=

# Set to `false` to hide the panel entirely (recommended on a public deploy,
# because it exposes account-level consumption).
# ENABLE_USAGE_PANEL=true

# How long provider-reported figures are cached, in seconds.
# USAGE_CACHE_SEC=300

# Look-back window for consumption queries, in days.
# USAGE_PERIOD_DAYS=30

# Timeout for the (non-critical) management API calls, in milliseconds.
# USAGE_TIMEOUT_MS=8000
