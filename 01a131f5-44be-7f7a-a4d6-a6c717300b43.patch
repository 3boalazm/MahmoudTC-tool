+        status: 200,
+        headers: { 'content-type': 'application/json' },
+      });
+    }
+    return new Response(JSON.stringify({ id: 'aai-2', status: 'completed', text: 'Hi.' }), {
+      status: 200,
+      headers: { 'content-type': 'application/json' },
+    });
