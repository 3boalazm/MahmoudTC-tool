+
+                {card.provider.consumption ? (
+                  <dl className="grid grid-cols-2 gap-2">
+                    <div className="rounded-xl bg-surface-1/70 px-2.5 py-2">
+                      <dt className="text-[10px] uppercase tracking-wider text-ink-500">
