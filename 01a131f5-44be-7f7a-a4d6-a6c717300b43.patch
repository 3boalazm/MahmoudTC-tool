+            ▾
+          </span>
+        </button>
+
+        {isOpen ? (
+          <div className="mt-3 space-y-2 text-[11px] leading-relaxed text-ink-400">
+            <p>
+              <span className="font-medium text-ink-300">{t('usage.provenanceLocalTitle')}</span>{' '}
+              {t('usage.provenanceLocal')}
