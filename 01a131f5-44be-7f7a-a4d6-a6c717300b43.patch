+        setEngines(list);
+        setAvailability(
+          Object.fromEntries(list.map((entry) => [entry.id, Boolean(entry.available)])),
+        );
+        if (Array.isArray(payload.engineOrder) && payload.engineOrder.length) {
+          setEngineOrder(payload.engineOrder);
+        }
