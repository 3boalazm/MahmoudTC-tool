+      setUploadProgress(null);
+      abortRef.current = null;
+    }
+  }, [
+    audio,
+    engine,
+    fallback,
+    fallbackOptionEnabled,
+    language,
+    largeUploads.enabled,
+    limits.maxUploadMb,
+    status,
+    stopTimer,
+  ]);
