+}
+
+/* -------------------------------------------------------------------------- */
+/* Engine 2 — Gladia (fallback)                                               */
+/* -------------------------------------------------------------------------- */
+
+export const GLADIA_DEFAULT_BASE_URL = 'https://api.gladia.io/v2';
