+    body: { engine: 'assemblyai', key: 'aai-typed-key-1234' },
+  });
+  jar.absorb({ headers: first.headers });
+  const second = await credentials(app.base, {
+    body: { engine: 'speechmatics', key: 'sm-typed-key-1234' },
+    cookie: jar.header(),
+  });
+  jar.absorb({ headers: second.headers });
+
+  assert.equal(second.body.connected, 4);
+  assert.equal(second.body.engines.filter((engine) => engine.source === 'settings').length, 2);
+
+  const cleared = await credentials(app.base, { method: 'DELETE', cookie: jar.header(), query: '?all=1' });
+  assert.equal(cleared.body.result.code, 'DISCONNECTED_ALL');
+  assert.equal(cleared.body.result.removed, 2);
+  assert.ok(
+    cleared.body.engines.every((engine) => engine.source === 'environment'),
+    'every engine falls back to the deployment key',
+  );
+});
+
+await scenario('the settings page is server-rendered with the real connection state', async () => {
+  const html = await (await fetch(`${app.base}/settings`)).text();
+
+  assert.match(html, /Deployment key/, 'SOURCE_STYLE chips are rendered on the server');
+  assert.match(html, /••••••••/);
+  assert.ok(!html.includes('test-deepgram-key'), 'no env key may appear in the markup');
+  assert.match(html, /stt_keys/, 'the storage explanation names the cookie');
+
+  const arabic = await (
+    await fetch(`${app.base}/settings`, { headers: { cookie: 'stt_locale=ar' } })
+  ).text();
+  assert.match(arabic, /مفتاح النشر/, 'the panel is translated too');
+});
+
+console.log('\nDouble failure handling');
+await scenario('returns a structured error when the whole chain fails', async () => {
+  await setModes({
+    deepgram: 'rate-limit',
+    gladia: 'server-error',
+    assemblyai: 'auth',
+    speechmatics: 'server-error',
+  });
+  const { status, body } = await transcribe(app.base);
+  assert.equal(status, 502);
+  assert.equal(body.error.code, 'SERVER_ERROR');
+  assert.match(body.error.message, /All 4 engines failed \(deepgram, gladia, assemblyai, speechmatics\)/i);
+  assert.equal(body.error.attempts.length, 4);
+  assert.deepEqual(
+    body.error.attempts.map((attempt) => attempt.code),
+    ['RATE_LIMITED', 'SERVER_ERROR', 'AUTH', 'SERVER_ERROR'],
+  );
+  // Provider detail stays server-side (it goes to the server log instead).
+  for (const attempt of body.error.attempts) assert.equal(attempt.detail, undefined);
+  assert.equal(body.error.detail, undefined);
+});
+
+await scenario('reports a Gladia job error with a non-retryable code', async () => {
+  await setModes({ deepgram: 'rate-limit', gladia: 'job-error' });
+  const { status, body } = await transcribe(app.base);
+  assert.equal(status, 502);
+  assert.equal(body.error.attempts[1].code, 'PROVIDER_ERROR');
+  assert.equal(body.error.attempts[1].retryable, false);
+});
+
+await scenario('surfaces an auth failure when the caller pins one engine', async () => {
+  await setModes({ deepgram: 'auth', gladia: 'ok' });
+  const { status, body } = await transcribe(app.base, {
+    fields: { engine: 'deepgram', fallback: 'false' },
+  });
+  assert.equal(status, 502);
+  assert.equal(body.error.code, 'AUTH');
+  assert.equal(body.error.attempts.length, 1);
+  assert.equal(body.error.attempts[0].engine, 'deepgram');
+});
+
+console.log('\nEngine pinning');
+await scenario('gladia-first ordering works when the user picks Gladia', async () => {
+  await setModes({ deepgram: 'ok', gladia: 'ok' });
+  const { status, body } = await transcribe(app.base, { fields: { engine: 'gladia' } });
+  assert.equal(status, 200);
+  assert.equal(body.engine, 'gladia');
+  assert.equal(body.fallbackUsed, false);
+});
+
+await scenario('a pinned engine with fallback disabled is used alone', async () => {
+  await setModes({ deepgram: 'ok', gladia: 'ok' });
+  const { status, body } = await transcribe(app.base, {
+    fields: { engine: 'deepgram', fallback: 'false' },
+  });
+  assert.equal(status, 200);
+  assert.equal(body.engine, 'deepgram');
+  assert.equal(body.attempts.length, 1);
+});
+
+await scenario('language hints reach the provider query string', async () => {
+  await setModes({ deepgram: 'ok', gladia: 'ok' });
+  const { status, body } = await transcribe(app.base, { fields: { language: 'es' } });
+  assert.equal(status, 200);
+  assert.equal(body.engine, 'deepgram');
+});
+
+await app.close();
+
+/* ------------------------------------------------------------------ */
+/* Vercel deployment simulation                                        */
+/*                                                                     */
+/* The app is booted with VERCEL=1 (so serverless-safe defaults apply)  */
+/* behind a proxy that enforces the platform's 4.5 MB body cap.         */
+/* ------------------------------------------------------------------ */
+
+console.log('\nVercel deployment (emulated)');
+const vercel = await startApp({
+  deepgramBase: `${deepgramMock.url}/v1/listen`,
+  gladiaBase: `${gladiaMock.url}/v2`,
+  simulateVercel: true,
+  // Let MAX_UPLOAD_MB fall through to its serverless default (4 MB).
+  omitEnv: ['MAX_UPLOAD_MB', 'BLOB_READ_WRITE_TOKEN'],
+});
+
+await scenario('health reports serverless-safe limits and the large-upload path', async () => {
+  const response = await fetch(`${vercel.base}/api/health`);
+  const body = await response.json();
+  assert.equal(response.status, 200);
+  assert.equal(body.runtime.platform, 'vercel');
+  assert.equal(body.limits.maxUploadMb, 4); // safe default, under the 4.5 MB cap
+  assert.equal(body.limits.platformBodyLimitMb, 4.5);
+  assert.equal(body.limits.maxDurationSeconds, 60);
+  assert.equal(body.largeUploads.enabled, false); // no Blob store connected
+});
+
+await scenario('a small file stays inside the platform limit and transcribes', async () => {
+  await setModes({ deepgram: 'ok', gladia: 'ok' });
+  const { status, body } = await transcribe(vercel.base);
+  assert.equal(status, 200);
+  assert.equal(body.engine, 'deepgram');
+});
+
+await scenario('the route’s own guard rejects a 4.2 MB upload with a helpful hint', async () => {
+  // 4.2 MB clears the platform's 4.5 MB cap, so the request reaches the app —
+  // and the app's own 4 MB inline ceiling rejects it with a useful message
+  // rather than letting the provider bounce it.
+  const { status, body } = await transcribe(vercel.base, {
+    audio: Buffer.alloc(Math.round(4.2 * 1024 * 1024), 7),
+    filename: 'big.wav',
+  });
+  assert.equal(status, 413);
+  assert.equal(body.error.code, 'BAD_REQUEST');
+  assert.match(body.error.message, /inline upload limit is 4 MB/);
+  assert.match(body.error.message, /MAX_UPLOAD_MB|Vercel Blob/);
+});
+
+await scenario('a 5 MB upload dies at the platform edge before the app can help', async () => {
+  // This is the exact failure the Vercel Blob path exists to avoid: the request
+  // never reaches the function, so no amount of server-side handling can save
+  // it. The UI therefore routes anything above the inline limit to Blob storage.
+  const { status, body } = await transcribe(vercel.base, {
+    audio: Buffer.alloc(5 * 1024 * 1024, 7),
+    filename: 'big.wav',
+  });
+  assert.equal(status, 413);
+  assert.equal(body.error.code, 'FUNCTION_PAYLOAD_TOO_LARGE');
+});
+
+await scenario('a remote audio URL is accepted and forwarded to the provider', async () => {
+  await setModes({ deepgram: 'ok', gladia: 'ok' });
+
+  // The URL is opaque to this app: it never fetches the bytes, it only hands the
+  // signed Blob URL to the provider, so a request can be tiny while the audio is
+  // arbitrarily large.
+  const form = new FormData();
+  form.append(
+    'audioUrl',
+    'https://mock123.public.blob.vercel-storage.com/stt-uploads/interview.webm',
+  );
+  form.append('filename', 'interview.webm');
+  form.append('engine', 'auto');
+  form.append('fallback', 'true');
+  form.append('durationSeconds', '900');
+
+  const response = await fetch(`${vercel.base}/api/transcribe`, { method: 'POST', body: form });
+  const body = await response.json();
+
+  assert.equal(response.status, 200);
+  assert.equal(body.engine, 'deepgram');
+  assert.equal(body.text, 'Primary engine transcript.');
+  assert.equal(body.audioSeconds, 900);
+});
+
+await scenario('a JSON body carrying an audioUrl is accepted too', async () => {
+  await setModes({ deepgram: 'ok', gladia: 'ok' });
+  const response = await fetch(`${vercel.base}/api/transcribe`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({
+      audioUrl: 'https://mock123.public.blob.vercel-storage.com/stt-uploads/clip.webm',
+      filename: 'clip.webm',
+    }),
+  });
+  const body = await response.json();
+  assert.equal(response.status, 200);
+  assert.equal(body.text, 'Primary engine transcript.');
+});
+
+await scenario('fallback still works for remote audio', async () => {
+  await setModes({ deepgram: 'payment-required', gladia: 'ok' });
+  const response = await fetch(`${vercel.base}/api/transcribe`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({
+      audioUrl: 'https://mock123.public.blob.vercel-storage.com/stt-uploads/clip.webm',
+    }),
+  });
+  const body = await response.json();
+  assert.equal(response.status, 200);
+  assert.equal(body.engine, 'gladia');
+  assert.equal(body.fallbackUsed, true);
+});
+
+await scenario('rejects a third-party URL to avoid becoming an SSRF proxy', async () => {
+  for (const hostile of [
+    'https://169.254.169.254/latest/meta-data/iam/security-credentials/',
+    'https://evil.example.com/audio.mp3',
+    'http://mock123.public.blob.vercel-storage.com/clip.webm',
+    'https://mock123.public.blob.vercel-storage.com.evil.com/clip.webm',
+  ]) {
+    const response = await fetch(`${vercel.base}/api/transcribe`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ audioUrl: hostile }),
+    });
+    const body = await response.json();
+    assert.equal(response.status, 400, `should reject ${hostile}`);
+    assert.match(body.error.message, /Vercel Blob store/i);
+  }
+});
+
+await scenario('the blob upload route refuses to mint tokens when unconfigured', async () => {
+  const response = await fetch(`${vercel.base}/api/blob/upload`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ type: 'blob.generate-client-token', payload: { pathname: 'x.webm' } }),
+  });
+  const body = await response.json();
+  assert.equal(response.status, 503);
+  assert.equal(body.error.code, 'MISSING_KEY');
+});
+
+await vercel.close();
+
+/* --------------------------------------------------- rate-limit stage */
+
+console.log('\nRate limiting (separate instance)');
+const limited = await startApp({
+  deepgramBase: `${deepgramMock.url}/v1/listen`,
+  gladiaBase: `${gladiaMock.url}/v2`,
+  extraEnv: { RATE_LIMIT_MAX: '2', RATE_LIMIT_WINDOW_SEC: '60' },
+});
+
+await scenario('returns 429 with a Retry-After header once the window is full', async () => {
+  await setModes({ deepgram: 'ok', gladia: 'ok' });
+  const first = await transcribe(limited.base, {});
+  const second = await transcribe(limited.base, {});
+  const third = await transcribe(limited.base, {});
+
+  assert.equal(first.status, 200);
+  assert.equal(second.status, 200);
+  assert.equal(third.status, 429);
+  assert.equal(third.body.error.code, 'RATE_LIMITED');
+  assert.match(third.body.error.message, /Too many transcription requests/i);
+});
+
+await scenario('health checks are not rate limited', async () => {
+  const response = await fetch(`${limited.base}/api/health`);
+  assert.equal(response.status, 200);
+});
+
+await limited.close();
+
+/* ------------------------------------------------------------------ teardown */
+
+await Promise.all([
+  deepgramMock.close(),
+  gladiaMock.close(),
+  assemblyaiMock.close(),
+  speechmaticsMock.close(),
+]);
+
+console.log(`\n${passed} passed, ${failures.length} failed\n`);
+
+if (failures.length) {
+  for (const failure of failures) console.error(`FAILED: ${failure.name}\n${failure.error.stack}\n`);
+  process.exit(1);
+}
diff --git a/tests/i18n.test.mjs b/tests/i18n.test.mjs
new file mode 100644
index 0000000..4c82af2
--- /dev/null
+++ b/tests/i18n.test.mjs
@@ -0,0 +1,301 @@
+/**
+ * tests/i18n.test.mjs
+ * ---------------------------------------------------------------------------
+ * Guards the localisation layer:
+ *
+ *   1. `en` and `ar` carry exactly the same keys — a missing translation can
+ *      never ship as a blank label or a raw key.
+ *   2. Every `t('some.key')` used in the app resolves in **both** languages.
+ *   3. Locale/theme plumbing (Accept-Language ranking, RTL direction, cookie
+ *      coercion) behaves as documented.
+ */
+
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+import {
+  DEFAULT_LOCALE,
+  DEFAULT_THEME,
+  LOCALES,
+  dirFor,
+  isLocale,
+  isRtl,
+  isTheme,
+  localeFromAcceptLanguage,
+  normaliseLocale,
+  normaliseTheme,
+  resolveLocale,
+} from '../lib/i18n/config.js';
+import { DICTIONARIES, createTranslator, flattenKeys, interpolate } from '../lib/i18n/index.js';
+
+import ar from '../lib/i18n/dictionaries/ar.js';
+import en from '../lib/i18n/dictionaries/en.js';
+
+const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+
+const flatEn = flattenKeys(en);
+const flatAr = flattenKeys(ar);
+
+/* ------------------------------------------------------------------ parity */
+
+test('English and Arabic dictionaries expose identical keys', () => {
+  const enKeys = Object.keys(flatEn).sort();
+  const arKeys = Object.keys(flatAr).sort();
+
+  const missingInArabic = enKeys.filter((key) => !(key in flatAr));
+  const missingInEnglish = arKeys.filter((key) => !(key in flatEn));
+
+  assert.deepEqual(missingInArabic, [], `keys missing from ar: ${missingInArabic.join(', ')}`);
+  assert.deepEqual(missingInEnglish, [], `keys missing from en: ${missingInEnglish.join(', ')}`);
+  assert.ok(enKeys.length > 250, `expected a full dictionary, found ${enKeys.length} keys`);
+});
+
+test('every string leaf is non-empty in both languages', () => {
+  for (const [key, value] of Object.entries(flatEn)) {
+    if (typeof value !== 'string') continue;
+    assert.ok(value.trim().length > 0, `en.${key} is empty`);
+    const arabic = flatAr[key];
+    assert.ok(
+      typeof arabic === 'string' && arabic.trim().length > 0,
+      `ar.${key} is empty or not a string`,
+    );
+  }
+});
+
+test('array sections keep the same length in both languages', () => {
+  for (const key of ['home.highlights', 'home.steps', 'home.explore', 'faq.items', 'faq.trouble']) {
+    const a = flatEn[key];
+    const b = flatAr[key];
+    assert.ok(Array.isArray(a), `en.${key} should be an array`);
+    assert.ok(Array.isArray(b), `ar.${key} should be an array`);
+    assert.equal(a.length, b.length, `${key} has ${a.length} items in en but ${b.length} in ar`);
+  }
+});
+
+/* ------------------------------------------- keys actually used by the app */
+
+/** Every file that can call `t('…')`. */
+function sourceFiles(dir, out = []) {
+  for (const entry of readdirSync(dir)) {
+    if (entry === 'node_modules' || entry.startsWith('.')) continue;
+    const full = path.join(dir, entry);
+    if (statSync(full).isDirectory()) {
+      sourceFiles(full, out);
+    } else if (/\.(?:js|mjs)$/.test(entry)) {
+      out.push(full);
+    }
+  }
+  return out;
+}
+
+test('every t() key used in the codebase exists in both dictionaries', () => {
+  const files = [
+    ...sourceFiles(path.join(root, 'app')),
+    ...sourceFiles(path.join(root, 'components')),
+    ...sourceFiles(path.join(root, 'hooks')),
+    ...sourceFiles(path.join(root, 'lib')),
+  ];
+
+  const used = new Set();
+  // Matches t('a.b') and t(`a.b`) but ignores template-interpolated keys.
+  const literal = /\bt\(\s*['"]([\w.]+)['"]/g;
+  const quoted = /\bt\(\s*`([\w.]+)`/g;
+
+  for (const file of files) {
+    const source = readFileSync(file, 'utf8');
+    for (const pattern of [literal, quoted]) {
+      pattern.lastIndex = 0;
+      let match;
+      while ((match = pattern.exec(source))) used.add(match[1]);
+    }
+  }
+
+  assert.ok(used.size > 60, `expected many translated keys, found ${used.size}`);
+
+  const unknown = [...used].filter((key) => !(key in flatEn) || !(key in flatAr));
+  assert.deepEqual(unknown, [], `unknown translation keys: ${unknown.join(', ')}`);
+
+  // Dynamic keys (engine error codes, recorder codes) are checked separately.
+  for (const code of [
+    'MISSING_KEY',
+    'AUTH',
+    'PAYMENT_REQUIRED',
+    'RATE_LIMITED',
+    'QUOTA_EXCEEDED',
+    'TIMEOUT',
+    'SERVER_ERROR',
+    'BAD_REQUEST',
+    'EMPTY_TRANSCRIPT',
+    'NETWORK',
+    'PROVIDER_ERROR',
+  ]) {
+    assert.ok(`errors.code.${code}` in flatEn, `missing errors.code.${code} (en)`);
+    assert.ok(`errors.code.${code}` in flatAr, `missing errors.code.${code} (ar)`);
+  }
+
+  /*
+   * These are built dynamically (`t(`settings.result.${code}`)`), so the literal
+   * scan above cannot see them — they are listed here instead.
+   */
+  for (const code of [
+    'OK',
+    'REJECTED',
+    'FORBIDDEN',
+    'NO_CREDIT',
+    'RATE_LIMITED',
+    'TIMEOUT',
+    'UNREACHABLE',
+    'UNEXPECTED',
+    'PROVIDER_ERROR',
+    'MISSING_KEY',
+    'DISABLED',
+    'ENABLED',
+    'DISCONNECTED',
+    'DISCONNECTED_ALL',
+    'NOT_CONNECTED',
+  ]) {
+    assert.ok(`settings.result.${code}` in flatEn, `missing settings.result.${code} (en)`);
+    assert.ok(`settings.result.${code}` in flatAr, `missing settings.result.${code} (ar)`);
+  }
+
+  for (const reason of [
+    'empty',
+    'too-short',
+    'too-long',
+    'whitespace',
+    'quotes',
+    'prefix',
+    'placeholder',
+    'unknown-engine',
+    'network',
+    'unknown',
+  ]) {
+    assert.ok(`settings.invalid.${reason}` in flatEn, `missing settings.invalid.${reason} (en)`);
+    assert.ok(`settings.invalid.${reason}` in flatAr, `missing settings.invalid.${reason} (ar)`);
+  }
+
+  for (const code of [
+    'UNSUPPORTED',
+    'PERMISSION_DENIED',
+    'NO_MICROPHONE',
+    'MIC_IN_USE',
+    'OVERCONSTRAINED',
+    'INSECURE',
+    'INTERRUPTED',
+    'START_FAILED',
+    'INIT_FAILED',
+    'RECORDER_ERROR',
+    'EMPTY_RECORDING',
+  ]) {
+    assert.ok(`source.rec.${code}` in flatEn, `missing source.rec.${code} (en)`);
+    assert.ok(`source.rec.${code}` in flatAr, `missing source.rec.${code} (ar)`);
+  }
+});
+
+test('interpolation placeholders match between languages', () => {
+  const placeholders = (value) => [...String(value).matchAll(/\{(\w+)\}/g)].map((m) => m[1]).sort();
+
+  const mismatched = [];
+  for (const [key, value] of Object.entries(flatEn)) {
+    if (typeof value !== 'string') continue;
+    const other = flatAr[key];
+    if (typeof other !== 'string') continue;
+    const a = placeholders(value);
+    const b = placeholders(other);
+    if (a.join(',') !== b.join(',')) mismatched.push(`${key}: en{${a}} vs ar{${b}}`);
+  }
+
+  assert.deepEqual(mismatched, [], `placeholder drift:\n${mismatched.join('\n')}`);
+});
+
+/* --------------------------------------------------------------- translator */
+
+test('the translator resolves dot paths and interpolates', () => {
+  const t = createTranslator('ar');
+
+  assert.equal(t('nav.studio'), 'المفرّغ');
+  assert.equal(t('common.enginesCount', { count: 4 }), '4 محرّكات');
+  assert.equal(t('usage.hours', { count: '1.5' }), '1.5 ساعة');
+
+  // Unknown keys are returned verbatim so they are obvious in development.
+  assert.equal(t('nope.not.here'), 'nope.not.here');
+
+  // Unknown placeholders survive instead of printing `undefined`.
+  assert.equal(interpolate('hello {name}', { other: 1 }), 'hello {name}');
+  assert.equal(interpolate('hello {name}', { name: 'world' }), 'hello world');
+
+  // Arrays come back raw for list rendering.
+  assert.equal(t('home.steps').length, 3);
+  assert.equal(t('faq.items').length, 8);
+});
+
+test('an unsupported locale falls back to the default dictionary', () => {
+  const t = createTranslator('fr');
+  assert.equal(t.locale, DEFAULT_LOCALE);
+  assert.equal(DICTIONARIES[DEFAULT_LOCALE], en);
+  assert.deepEqual(DICTIONARIES, { en, ar });
+});
+
+/* ------------------------------------------------------------- locale rules */
+
+test('locale helpers coerce and report direction', () => {
+  assert.deepEqual(LOCALES, ['en', 'ar']);
+  assert.equal(isLocale('ar'), true);
+  assert.equal(isLocale('fr'), false);
+  assert.equal(normaliseLocale('AR-eg'), 'ar');
+  assert.equal(normaliseLocale('en-US'), 'en');
+  assert.equal(normaliseLocale('klingon'), DEFAULT_LOCALE);
+  assert.equal(normaliseLocale(undefined), DEFAULT_LOCALE);
+  assert.equal(dirFor('ar'), 'rtl');
+  assert.equal(dirFor('en'), 'ltr');
+  assert.equal(isRtl('ar'), true);
+  assert.equal(isRtl('en'), false);
+});
+
+test('Accept-Language picks the highest-ranked supported language', () => {
+  assert.equal(localeFromAcceptLanguage('ar-EG,ar;q=0.9,en;q=0.8'), 'ar');
+  assert.equal(localeFromAcceptLanguage('en-GB,en;q=0.9,ar;q=0.2'), 'en');
+  assert.equal(localeFromAcceptLanguage('fr-CH,fr;q=0.9,ar;q=0.8'), 'ar');
+  assert.equal(localeFromAcceptLanguage('de,es'), DEFAULT_LOCALE);
+  assert.equal(localeFromAcceptLanguage(''), DEFAULT_LOCALE);
+  assert.equal(localeFromAcceptLanguage(undefined), DEFAULT_LOCALE);
+});
+
+test('an explicit cookie beats the browser preference', () => {
+  assert.equal(resolveLocale({ cookie: 'en', acceptLanguage: 'ar-EG,ar;q=0.9' }), 'en');
+  assert.equal(resolveLocale({ cookie: 'ar', acceptLanguage: 'en-US,en;q=0.9' }), 'ar');
+  assert.equal(resolveLocale({ acceptLanguage: 'ar' }), 'ar');
+  assert.equal(resolveLocale({ cookie: 'ar-EG' }), 'ar');
+  assert.equal(resolveLocale({}), DEFAULT_LOCALE);
+});
+
+test('theme helpers only accept real themes', () => {
+  assert.equal(DEFAULT_THEME, 'system');
+  assert.equal(isTheme('light'), true);
+  assert.equal(isTheme('dark'), true);
+  assert.equal(isTheme('system'), true);
+  assert.equal(isTheme('solarized'), false);
+  assert.equal(normaliseTheme('LIGHT'), DEFAULT_THEME, 'case matters, fall back safely');
+  assert.equal(normaliseTheme('dark'), 'dark');
+  assert.equal(normaliseTheme(undefined), DEFAULT_THEME);
+});
+
+test('the pre-paint theme script is self-contained and reads the cookie key', () => {
+  const source = readFileSync(path.join(root, 'components/providers/ThemeProvider.js'), 'utf8');
+  const match = source.match(/export const THEME_SCRIPT = `([\s\S]*?)`;/);
+  assert.ok(match, 'THEME_SCRIPT must be defined');
+
+  const script = match[1];
+  // The cookie name is interpolated from THEME_COOKIE, so accept either form.
+  assert.match(
+    script,
+    /stt_theme|\$\{THEME_COOKIE\}/,
+    'must read the same cookie the server writes',
+  );
+  assert.match(script, /prefers-color-scheme: dark/);
+  assert.match(script, /data-theme/, 'must set the attribute Tailwind reacts to');
+  assert.ok(!script.includes('import '), 'must not depend on a bundler');
+});
diff --git a/tests/mock-providers.mjs b/tests/mock-providers.mjs
new file mode 100644
index 0000000..51a7714
--- /dev/null
+++ b/tests/mock-providers.mjs
@@ -0,0 +1,446 @@
+/**
+ * tests/mock-providers.mjs
+ * ---------------------------------------------------------------------------
+ * Stand-in servers for every engine the app can talk to, used by `npm run test:e2e`.
+ *
+ * The app never forwards client-controlled headers or fields to a provider (and
+ * it should not), so behaviour is configured out-of-band through a control
+ * endpoint on the mock itself:
+ *
+ *   POST /__scenario   { "mode": "rate-limit" }
+ *
+ * Deepgram modes:     ok | rate-limit | payment-required | auth | server-error | empty
+ * Gladia modes:       ok | upload-error | server-error | job-error
+ * AssemblyAI modes:   ok | rate-limit | auth | server-error | job-error
+ * Speechmatics modes: ok | rate-limit | auth | server-error | job-error
+ */
+
+import { createServer } from 'node:http';
+
+const readBody = (request) =>
+  new Promise((resolve) => {
+    const chunks = [];
+    request.on('data', (chunk) => chunks.push(chunk));
+    request.on('end', () => resolve(Buffer.concat(chunks)));
+  });
+
+const json = (response, status, body) => {
+  response.writeHead(status, { 'content-type': 'application/json' });
+  response.end(JSON.stringify(body));
+};
+
+/**
+ * Shared scaffolding: a mutable scenario, the `/__scenario` control endpoint,
+ * and a request counter so tests can assert how many calls were made.
+ */
+function createMock({ onRequest, port = 0 }) {
+  const state = { mode: 'ok', requests: 0, lastAuth: null };
+
+  const server = createServer(async (request, response) => {
+    const url = new URL(request.url, 'http://localhost');
+    const raw = await readBody(request);
+
+    if (url.pathname === '/__scenario') {
+      const parsed = raw.length ? JSON.parse(raw.toString('utf8')) : {};
+      if (typeof parsed.mode === 'string') state.mode = parsed.mode;
+      state.requests = 0;
+      return json(response, 200, { mode: state.mode });
+    }
+
+    if (url.pathname === '/__state') {
+      return json(response, 200, {
+        mode: state.mode,
+        requests: state.requests,
+        lastAuth: state.lastAuth,
+      });
+    }
+
+    state.requests += 1;
+    /*
+     * Remember the credential this request carried, verbatim.
+     * Lets a test prove which key the app actually used — the env key or the
+     * one a visitor typed into the settings page.
+     */
+    state.lastAuth =
+      request.headers.authorization ?? request.headers['x-gladia-key'] ?? null;
+    return onRequest({ request, response, url, state, raw });
+  });
+
+  return new Promise((resolve) => {
+    server.listen(port, '127.0.0.1', () => {
+      resolve({
+        url: `http://127.0.0.1:${server.address().port}`,
+        state,
+        /** Change what the mock does for the next requests. */
+        async setMode(mode) {
+          await fetch(`http://127.0.0.1:${server.address().port}/__scenario`, {
+            method: 'POST',
+            headers: { 'content-type': 'application/json' },
+            body: JSON.stringify({ mode }),
+          });
+        },
+        get requests() {
+          return state.requests;
+        },
+        get lastAuth() {
+          return state.lastAuth;
+        },
+        close: () => new Promise((done) => server.close(done)),
+      });
+    });
+  });
+}
+
+/* ------------------------------------------------------------------ deepgram */
+
+export function startDeepgramMock(port = 0) {
+  return createMock({
+    port,
+    onRequest({ response, url, state }) {
+      /*
+       * Management API stand-ins, so `/api/usage` can be exercised end to end.
+       * These are the only endpoints that legitimately report a *remaining*
+       * balance, which makes them worth faking precisely.
+       */
+      /*
+       * Key-validation probe used by the settings page. Unlike the management
+       * endpoints below it needs no scope, and `auth` mode rejects it so the UI
+       * can be tested against a genuinely invalid key.
+       */
+      if (url.pathname === '/v1/auth/token') {
+        if (state.mode === 'auth') {
+          return json(response, 401, { err_code: 'INVALID_AUTH', err_msg: 'Invalid credentials.' });
+        }
+        return json(response, 200, { api_key_id: 'mock-key', scopes: ['member'] });
+      }
+
+      if (url.pathname === '/v1/projects') {
+        return json(response, 200, {
+          projects: [{ project_id: 'mock-project', name: 'Mock project' }],
+        });
+      }
+      if (url.pathname === '/v1/projects/mock-project/balances') {
+        return json(response, 200, {
+          balances: [
+            { balance_id: 'balance-1', amount: 120.45, units: 'USD' },
+            { balance_id: 'balance-2', amount: 3, units: 'USD' },
+          ],
+        });
+      }
+      if (url.pathname === '/v1/projects/mock-project/usage/breakdown') {
+        return json(response, 200, {
+          start: url.searchParams.get('start'),
+          end: url.searchParams.get('end'),
+          results: [
+            { hours: 1.25, requests: 9, grouping: { models: ['nova-2'] } },
+            { hours: 0.25, requests: 3, grouping: { models: ['nova-3'] } },
+          ],
+        });
+      }
+
+      if (url.pathname !== '/v1/listen') {
+        return json(response, 404, { err_msg: 'not found' });
+      }
+
+      switch (state.mode) {
+        case 'rate-limit':
+          return json(response, 429, { err_msg: 'Rate limit exceeded. Please retry later.' });
+        case 'payment-required':
+          return json(response, 402, {
+            err_msg: 'Insufficient funds. Please add a payment method to continue.',
+          });
+        case 'auth':
+          return json(response, 401, { err_msg: 'Invalid credentials.' });
+        case 'server-error':
+          return json(response, 503, { err_msg: 'Service temporarily unavailable.' });
+        default:
+          break;
+      }
+
+      const transcript = state.mode === 'empty' ? '' : 'Primary engine transcript.';
+
+      return json(response, 200, {
+        metadata: { request_id: 'dg-mock-1', duration: 3.5, language: 'en' },
+        results: {
+          channels: [
+            {
+              detected_language: 'en',
+              alternatives: [
+                {
+                  transcript,
+                  confidence: 0.97,
+                  words: transcript
+                    ? [
+                        { word: 'primary', punctuated_word: 'Primary', start: 0, end: 0.7, confidence: 0.98 },
+                        { word: 'engine', punctuated_word: 'engine', start: 0.7, end: 1.2, confidence: 0.96 },
+                      ]
+                    : [],
+                  paragraphs: {
+                    paragraphs: [{ sentences: transcript ? [{ text: transcript }] : [] }],
+                  },
+                },
+              ],
+            },
+          ],
+        },
+      });
+    },
+  });
+}
+
+/* -------------------------------------------------------------------- gladia */
+
+export function startGladiaMock(port = 0) {
+  let jobId = 0;
+
+  return createMock({
+    port,
+    onRequest({ response, request, url, state }) {
+      if (state.mode === 'upload-error' && url.pathname === '/v2/upload') {
+        return json(response, 500, { message: 'Gladia upload failed.' });
+      }
+
+      // A generic provider outage: every write endpoint answers 500.
+      if (state.mode === 'server-error' && request.method === 'POST') {
+        return json(response, 500, { message: 'Gladia is temporarily unavailable.' });
+      }
+
+      // Key probe: reading an id that does not exist. 404 = "key accepted".
+      if (url.pathname.startsWith('/v2/pre-recorded/')) {
+        if (state.mode === 'auth') {
+          return json(response, 401, { message: 'Invalid API key.' });
+        }
+        return json(response, 404, { message: 'No such transcription.' });
+      }
+
+      if (url.pathname === '/v2/upload' && request.method === 'POST') {
+        return json(response, 200, {
+          audio_url: 'https://mock.gladia.local/file/1',
+          audio_metadata: { filename: 'clip.webm', size: 1024, audio_duration: 3.5 },
+        });
+      }
+
+      if (url.pathname === '/v2/transcription' && request.method === 'POST') {
+        jobId += 1;
+        return json(response, 201, {
+          id: `job-${jobId}`,
+          status: 'queued',
+          request_id: 'G-mock-1',
+        });
+      }
+
+      if (url.pathname.startsWith('/v2/transcription/') && request.method === 'GET') {
+        const id = url.pathname.split('/').pop();
+
+        if (state.mode === 'job-error') {
+          return json(response, 200, {
+            id,
+            status: 'error',
+            error_code: 'INTEGRATION_ERROR',
+            message: 'Gladia could not decode the audio.',
+          });
+        }
+
+        return json(response, 200, {
+          id,
+          status: 'done',
+          request_id: 'G-mock-1',
+          file: { audio_duration: 3.5 },
+          result: {
+            transcription: {
+              full_transcript: 'Fallback engine transcript.',
+              languages: ['en'],
+              utterances: [{ text: 'Fallback engine transcript.', start: 0, end: 1.6, speaker: 0 }],
+            },
+          },
+        });
+      }
+
+      return json(response, 404, { message: 'not found' });
+    },
+  });
+}
+
+/* ---------------------------------------------------------------- assemblyai */
+
+export function startAssemblyAIMock(port = 0) {
+  let jobId = 0;
+
+  return createMock({
+    port,
+    onRequest({ response, request, url, state }) {
+      if (url.pathname === '/upload' && request.method === 'POST') {
+        if (state.mode === 'auth') return json(response, 401, { error: 'Authentication failed.' });
+        if (state.mode === 'server-error') return json(response, 500, { error: 'Upload failed.' });
+        return json(response, 200, { upload_url: 'https://mock.assemblyai.local/upload/1' });
+      }
+
+      // Key probe: list one transcript. 200 = key accepted.
+      if (url.pathname === '/transcript' && request.method === 'GET') {
+        if (state.mode === 'auth') {
+          return json(response, 401, { error: 'Authentication error, API key invalid.' });
+        }
+        return json(response, 200, { transcripts: [], page_details: { limit: 1, result_count: 0 } });
+      }
+
+      if (url.pathname === '/transcript' && request.method === 'POST') {
+        switch (state.mode) {
+          case 'rate-limit':
+            return json(response, 429, { error: 'Too many requests.' });
+          case 'auth':
+            return json(response, 401, { error: 'Authentication failed.' });
+          case 'server-error':
+            return json(response, 500, { error: 'Internal server error.' });
+          default:
+            break;
+        }
+
+        jobId += 1;
+        return json(response, 200, { id: `aai-${jobId}`, status: 'queued' });
+      }
+
+      if (url.pathname.startsWith('/transcript/') && request.method === 'GET') {
+        const id = url.pathname.split('/').pop();
+
+        if (state.mode === 'job-error') {
+          return json(response, 200, {
+            id,
+            status: 'error',
+            error: 'Audio file could not be decoded.',
+          });
+        }
+
+        return json(response, 200, {
+          id,
+          status: 'completed',
+          language_code: 'en_us',
+          audio_duration: 3.5,
+          confidence: 0.94,
+          text: 'Third engine transcript.',
+          // Note: AssemblyAI reports **milliseconds** — the parser converts them.
+          words: [
+            { text: 'Third', start: 0, end: 700, confidence: 0.95 },
+            { text: 'engine', start: 700, end: 1200, confidence: 0.93 },
+          ],
+          utterances: [{ text: 'Third engine transcript.', start: 0, end: 1600, confidence: 0.94 }],
+        });
+      }
+
+      return json(response, 404, { error: 'not found' });
+    },
+  });
+}
+
+/* -------------------------------------------------------------- speechmatics */
+
+export function startSpeechmaticsMock(port = 0) {
+  let jobId = 0;
+
+  return createMock({
+    port,
+    onRequest({ response, request, url, state }) {
+      if (url.pathname === '/jobs/' && request.method === 'POST') {
+        switch (state.mode) {
+          case 'rate-limit':
+            return json(response, 429, {
+              code: 429,
+              error: 'Max concurrent running jobs exceeded',
+            });
+          case 'auth':
+            return json(response, 401, { code: 401, error: 'Permission Denied' });
+          case 'server-error':
+            return json(response, 500, { code: 500, error: 'Internal Server Error' });
+          default:
+            break;
+        }
+
+        jobId += 1;
+        return json(response, 201, { id: `sm-${jobId}`, status: 'running' });
+      }
+
+      // Key probe (and the listing endpoint): 200 = key accepted.
+      if (url.pathname === '/jobs' && request.method === 'GET') {
+        if (state.mode === 'auth') {
+          return json(response, 401, { code: 401, error: 'Permission Denied' });
+        }
+      }
+
+      if (url.pathname === '/jobs' && request.method === 'GET') {
+        return json(response, 200, {
+          jobs: [],
+          count: 0,
+        });
+      }
+
+      if (url.pathname === '/usage' && request.method === 'GET') {
+        const row = {
+          mode: 'batch',
+          type: 'transcription',
+          language: 'en',
+          operating_point: 'enhanced',
+          count: 4,
+          duration_hrs: 0.25,
+        };
+        return json(response, 200, {
+          since: url.searchParams.get('since') ?? '2026-01-01',
+          until: url.searchParams.get('until') ?? '2026-01-31',
+          summary: [row],
+          details: [row],
+        });
+      }
+
+      if (/^\/jobs\/[^/]+$/.test(url.pathname) && request.method === 'GET') {
+        const id = url.pathname.split('/').pop();
+
+        if (state.mode === 'job-error') {
+          return json(response, 200, {
+            job: {
+              id,
+              status: 'rejected',
+              errors: [{ type: 'audio_error', message: 'Audio decode failed' }],
+            },
+          });
+        }
+
+        // The real API nests the status: { "job": { "id": …, "status": "done" } }.
+        return json(response, 200, { job: { id, status: 'done' } });
+      }
+
+      if (/^\/jobs\/[^/]+\/transcript$/.test(url.pathname) && request.method === 'GET') {
+        const id = url.pathname.split('/')[2];
+
+        return json(response, 200, {
+          format: 'json-v2',
+          job: { id, created_at: '2026-01-01T00:00:00Z', data_name: 'clip.webm', duration: 3.5 },
+          metadata: {
+            transcription_config: { language: 'en', model: 'enhanced' },
+            language_pack_info: { language_description: 'English', word_delimiter: ' ' },
+          },
+          results: [
+            {
+              type: 'word',
+              start_time: 0,
+              end_time: 0.4,
+              alternatives: [{ content: 'Fourth', confidence: 0.92 }],
+            },
+            {
+              type: 'word',
+              start_time: 0.4,
+              end_time: 0.9,
+              alternatives: [{ content: 'engine', confidence: 0.9 }],
+            },
+            {
+              type: 'punctuation',
+              start_time: 0.9,
+              end_time: 0.9,
+              attaches_to: 'previous',
+              alternatives: [{ content: '.', confidence: 1 }],
+            },
+          ],
+        });
+      }
+
+      return json(response, 404, { code: 404, error: 'not found' });
+    },
+  });
+}
