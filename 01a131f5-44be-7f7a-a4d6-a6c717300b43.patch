diff --git a/app/api/blob/upload/route.js b/app/api/blob/upload/route.js
new file mode 100644
index 0000000..bb84070
--- /dev/null
+++ b/app/api/blob/upload/route.js
@@ -0,0 +1,124 @@
+/**
+ * POST /api/blob/upload
+ * ---------------------------------------------------------------------------
+ * Mints the short-lived client tokens that let the browser upload audio
+ * **directly** to Vercel Blob. This is what unlocks files larger than the 4.5 MB
+ * serverless request limit.
+ *
+ * Only mounted meaningfully when a Blob store is connected; otherwise it
+ * answers 503 and the client keeps using inline uploads.
+ *
+ * Security notes
+ *   • `onBeforeGenerateToken` is the authorisation gate. This app ships without
+ *     user accounts, so the gate enforces: the feature must be enabled, the
+ *     caller must be under the same rate limit as /api/transcribe, only
+ *     audio/video MIME types are accepted, and a hard size ceiling applies.
+ *     If you add authentication, check the session here — the official docs
+ *     make this the recommended pattern.
+ *   • Blobs are requested with `public` access because Deepgram and Gladia must
+ *     fetch the URL themselves; they are deleted as soon as transcription ends.
+ */
+
+import { handleUpload } from '@vercel/blob/client';
+
+import { ERROR_CODES } from '@/lib/engines';
+import { blobMaxBytes, isBlobEnabled } from '@/lib/server/blob';
+import { serverConfig } from '@/lib/server/config';
+import { checkRateLimit, clientIdentifier } from '@/lib/server/rate-limit';
+import { errorResponse, jsonResponse, redact } from '@/lib/server/http';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+const ALLOWED_CONTENT_TYPES = [
+  'audio/*',
+  'video/mp4',
+  'video/webm',
+  'video/quicktime',
+  'application/ogg',
+  'application/octet-stream',
+];
+
+/** Only these extensions get a token, so the store never fills with junk. */
+const ALLOWED_EXTENSIONS = [
+  'mp3', 'wav', 'm4a', 'mp4', 'webm', 'ogg', 'oga', 'opus', 'flac', 'aac',
+  'amr', 'aiff', 'aif', 'mov', 'mpeg', 'mpga', '3gp', 'mkv',
+];
+
+export async function POST(request) {
+  if (!isBlobEnabled()) {
+    return errorResponse({
+      status: 503,
+      code: ERROR_CODES.MISSING_KEY,
+      message:
+        'Large-file uploads are not configured on this deployment. Connect a Vercel Blob store (BLOB_READ_WRITE_TOKEN) or keep uploads under the inline limit.',
+    });
+  }
+
+  const limit = checkRateLimit(`blob:${clientIdentifier(request)}`, serverConfig.rateLimit);
+  if (!limit.allowed) {
+    return errorResponse({
+      status: 429,
+      code: ERROR_CODES.RATE_LIMITED,
+      message: `Too many upload requests. Please retry in ${limit.retryAfterSeconds}s.`,
+      extraHeaders: { 'Retry-After': String(limit.retryAfterSeconds) },
+    });
+  }
+
+  let body;
+  try {
+    body = await request.json();
+  } catch {
+    return errorResponse({
+      status: 400,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: 'Expected a JSON body describing the upload.',
+    });
+  }
+
+  try {
+    const result = await handleUpload({
+      body,
+      request,
+      token: serverConfig.blob.token,
+
+      onBeforeGenerateToken: async (pathname) => {
+        const extension = pathname.includes('.')
+          ? pathname.split('.').pop().toLowerCase()
+          : '';
+
+        if (!ALLOWED_EXTENSIONS.includes(extension)) {
+          throw new Error(
+            `Unsupported file extension ".${extension}". Allowed: ${ALLOWED_EXTENSIONS.join(', ')}.`,
+          );
+        }
+
+        return {
+          allowedContentTypes: ALLOWED_CONTENT_TYPES,
+          maximumSizeInBytes: blobMaxBytes(),
+          addRandomSuffix: true,
+          // The token is only good for a couple of minutes.
+          validUntil: Date.now() + 2 * 60 * 1000,
+          tokenPayload: JSON.stringify({ issuedAt: Date.now() }),
+        };
+      },
+
+      /**
+       * Fired by Vercel once the browser finishes uploading. It cannot reach
+       * localhost, so on `npm run dev` this simply does not run — the client
+       * already has the URL it needs, so nothing depends on it.
+       */
+      onUploadCompleted: async ({ blob }) => {
+        console.warn(`[blob] upload completed: ${blob?.pathname ?? 'unknown'}`);
+      },
+    });
+
+    return jsonResponse(result);
+  } catch (error) {
+    return errorResponse({
+      status: 400,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: redact(String(error?.message || 'The upload could not be authorised.')),
+    });
+  }
+}
diff --git a/app/api/credentials/route.js b/app/api/credentials/route.js
new file mode 100644
index 0000000..d42838c
--- /dev/null
+++ b/app/api/credentials/route.js
@@ -0,0 +1,308 @@
+/**
+ * /api/credentials
+ * ---------------------------------------------------------------------------
+ * Reads and writes the **visitor's own** provider keys.
+ *
+ * Why a cookie?
+ *   This app has no database and has to run on Vercel, where a serverless
+ *   instance cannot persist a file. Storing a key in an httpOnly cookie on the
+ *   visitor's device keeps every promise the app already made: no server-side
+ *   account, no shared key pool, nothing that can leak to another visitor.
+ *
+ *   GET    /api/credentials                → masked status of every engine
+ *   POST   /api/credentials                → { engine, key?, action? }
+ *   DELETE /api/credentials?engine=gladia  → forget one engine
+ *   DELETE /api/credentials?all=1          → forget everything (disconnect)
+ *
+ * Actions
+ *   save     (default when `key` is present) validate, store, then probe it
+ *   test     probe the given key, or the one already in use, without storing
+ *   disable  shadow the deployment's env key for this browser only
+ *   enable   drop that shadow, going back to the environment key
+ *
+ * Guarantees
+ *   • A key is never returned by any response — only a mask such as `sk_1••••4f2a`.
+ *   • Cross-site requests are refused (`Sec-Fetch-Site`), so another site cannot
+ *     read your status or write a key of its own.
+ *   • Writes are rate-limited: probing a provider costs a round trip.
+ */
+
+import { NextResponse } from 'next/server';
+
+import { ERROR_CODES } from '@/lib/engines';
+import { ENGINES } from '@/lib/engines-meta';
+import { serverConfig, environmentKeys } from '@/lib/server/config';
+import {
+  KEYS_COOKIE,
+  credentialPanelState,
+  keysCookieOptions,
+  parseCredentialCookie,
+  serialiseCredentialCookie,
+  validateKeyShape,
+} from '@/lib/server/credentials';
+import { errorResponse, jsonResponse } from '@/lib/server/http';
+import { checkRateLimit, clientIdentifier } from '@/lib/server/rate-limit';
+import { verifyEngineCredentials } from '@/lib/server/verify';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+const KNOWN_ENGINES = ENGINES.map((engine) => engine.id);
+const ACTIONS = ['save', 'test', 'disable', 'enable'];
+
+/** Same-origin only: these endpoints read and write personal credentials. */
+function crossSite(request) {
+  const fetchSite = request.headers.get('sec-fetch-site');
+  return Boolean(fetchSite) && !['same-origin', 'same-site', 'none'].includes(fetchSite);
+}
+
+function readCredentials(request) {
+  return parseCredentialCookie(request.cookies.get(KEYS_COOKIE)?.value);
+}
+
+/** Every response carries the full, masked state so the UI never has to guess. */
+function statePayload({ credentials, extra = {} } = {}) {
+  return {
+    ...credentialPanelState({
+      credentials,
+      envKeys: environmentKeys(),
+      engineOrder: serverConfig.engineOrder,
+      usagePanel: serverConfig.usage.enabled,
+    }),
+    ...extra,
+  };
+}
+
+/** A JSON response that also (re)writes the credentials cookie. */
+function jsonWithCredentials(body, map, { status = 200 } = {}) {
+  const response = NextResponse.json(body, {
+    status,
+    headers: { 'Cache-Control': 'no-store, max-age=0' },
+  });
+
+  const value = serialiseCredentialCookie(map);
+  if (value) {
+    response.cookies.set(KEYS_COOKIE, value, keysCookieOptions());
+  } else {
+    response.cookies.set(KEYS_COOKIE, '', { ...keysCookieOptions(), maxAge: 0 });
+  }
+  return response;
+}
+
+/* --------------------------------------------------------------------- GET */
+
+export async function GET(request) {
+  if (crossSite(request)) {
+    return errorResponse({
+      status: 403,
+      code: ERROR_CODES.AUTH,
+      message: 'Cross-site requests for credential status are not allowed.',
+    });
+  }
+
+  return jsonResponse(statePayload({ credentials: readCredentials(request) }));
+}
+
+/* -------------------------------------------------------------------- POST */
+
+export async function POST(request) {
+  if (crossSite(request)) {
+    return errorResponse({
+      status: 403,
+      code: ERROR_CODES.AUTH,
+      message: 'Cross-site credential changes are not allowed.',
+    });
+  }
+
+  // Saving or testing a key talks to a provider, so it shares a budget.
+  const limit = checkRateLimit(`credentials:${clientIdentifier(request)}`, {
+    max: Math.max(serverConfig.rateLimit.max, 20),
+    windowMs: serverConfig.rateLimit.windowMs,
+  });
+  if (!limit.allowed) {
+    return errorResponse({
+      status: 429,
+      code: ERROR_CODES.RATE_LIMITED,
+      message: `Too many credential requests. Please retry in ${limit.retryAfterSeconds}s.`,
+      extraHeaders: { 'Retry-After': String(limit.retryAfterSeconds) },
+    });
+  }
+
+  let payload;
+  try {
+    payload = await request.json();
+  } catch {
+    return errorResponse({
+      status: 400,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: 'Expected a JSON body: { engine, key?, action? }.',
+    });
+  }
+
+  const engine = String(payload?.engine ?? '').trim();
+  if (!KNOWN_ENGINES.includes(engine)) {
+    return errorResponse({
+      status: 400,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: `Unknown engine "${payload?.engine}". Known engines: ${KNOWN_ENGINES.join(', ')}.`,
+    });
+  }
+
+  /*
+   * A body that mentions a key is a save attempt — even when the key is empty,
+   * because the validation message is the useful part of that answer.
+   */
+  const action = ACTIONS.includes(payload?.action)
+    ? payload.action
+    : payload && 'key' in payload
+      ? 'save'
+      : null;
+
+  if (!action) {
+    return errorResponse({
+      status: 400,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: `Nothing to do for "${engine}": pass a key to save, or an action (${ACTIONS.join(', ')}).`,
+    });
+  }
+
+  const credentials = readCredentials(request);
+  const next = { ...credentials };
+  const envKey = environmentKeys()[engine] ?? null;
+
+  /* ------------------------------------------------------------- disable/enable */
+
+  if (action === 'disable') {
+    next[engine] = { disabled: true };
+    return jsonWithCredentials(
+      statePayload({ credentials: next, extra: { result: { engine, ok: true, code: 'DISABLED' } } }),
+      next,
+    );
+  }
+
+  if (action === 'enable') {
+    delete next[engine];
+    return jsonWithCredentials(
+      statePayload({ credentials: next, extra: { result: { engine, ok: true, code: 'ENABLED' } } }),
+      next,
+    );
+  }
+
+  /* ------------------------------------------------------------------- test */
+
+  if (action === 'test') {
+    const candidate = typeof payload?.key === 'string' && payload.key.trim() ? payload.key.trim() : null;
+    const stored = next[engine]?.key ?? null;
+    const key = candidate || stored || envKey;
+
+    if (!key) {
+      return jsonResponse(
+        statePayload({
+          credentials: next,
+          extra: { result: { engine, ok: false, code: 'MISSING_KEY', status: null, detail: null } },
+        }),
+      );
+    }
+
+    const verification = await verifyEngineCredentials(engine, { ...serverConfig[engine], apiKey: key });
+    return jsonResponse(
+      statePayload({
+        credentials: next,
+        extra: { result: { engine, source: candidate ? 'input' : stored ? 'settings' : 'environment', ...verification } },
+      }),
+    );
+  }
+
+  /* -------------------------------------------------------------------- save */
+
+  const shape = validateKeyShape(engine, payload?.key);
+  if (!shape.ok) {
+    return errorResponse({
+      status: 400,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: 'That does not look like an API key.',
+      detail: shape.reason,
+      extraHeaders: { 'X-Key-Rejected': shape.reason },
+    });
+  }
+
+  const verification = await verifyEngineCredentials(engine, {
+    ...serverConfig[engine],
+    apiKey: shape.key,
+  });
+
+  /*
+   * A 401 is the one answer that is not a matter of interpretation: this key
+   * cannot be used. Refusing to store it means fixing a typo cannot cost you a
+   * working key on the way in — and the previous key (yours or the deployment's)
+   * stays in place until a real one is saved.
+   *
+   * Everything else is stored: `NO_CREDIT` needs a top-up, `UNREACHABLE` and
+   * `TIMEOUT` say nothing about the key, and the panel reports the outcome
+   * verbatim so the decision stays with the person holding the account.
+   */
+  if (verification.code === 'REJECTED') {
+    return jsonResponse(
+      statePayload({
+        credentials,
+        extra: { result: { engine, source: 'input', stored: false, ...verification } },
+      }),
+    );
+  }
+
+  next[engine] = { key: shape.key };
+
+  return jsonWithCredentials(
+    statePayload({
+      credentials: next,
+      extra: { result: { engine, source: 'input', stored: true, ...verification } },
+    }),
+    next,
+  );
+}
+
+/* ------------------------------------------------------------------ DELETE */
+
+export async function DELETE(request) {
+  if (crossSite(request)) {
+    return errorResponse({
+      status: 403,
+      code: ERROR_CODES.AUTH,
+      message: 'Cross-site credential changes are not allowed.',
+    });
+  }
+
+  const url = new URL(request.url);
+  const credentials = readCredentials(request);
+
+  if (url.searchParams.get('all') === '1' || url.searchParams.get('all') === 'true') {
+    return jsonWithCredentials(
+      statePayload({
+        credentials: {},
+        extra: { result: { engine: null, ok: true, code: 'DISCONNECTED_ALL', removed: Object.keys(credentials).length } },
+      }),
+      {},
+    );
+  }
+
+  const engine = String(url.searchParams.get('engine') ?? '').trim();
+  if (!KNOWN_ENGINES.includes(engine)) {
+    return errorResponse({
+      status: 400,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: 'Pass ?engine=<id> or ?all=1.',
+    });
+  }
+
+  const next = { ...credentials };
+  const existed = Boolean(next[engine]?.key) || Boolean(next[engine]?.disabled);
+  delete next[engine];
+
+  return jsonWithCredentials(
+    statePayload({
+      credentials: next,
+      extra: { result: { engine, ok: true, code: existed ? 'DISCONNECTED' : 'NOT_CONNECTED', removed: existed ? 1 : 0 } },
+    }),
+    next,
+  );
+}
diff --git a/app/api/health/route.js b/app/api/health/route.js
new file mode 100644
index 0000000..dce6713
--- /dev/null
+++ b/app/api/health/route.js
@@ -0,0 +1,107 @@
+/**
+ * GET /api/health
+ * ---------------------------------------------------------------------------
+ * Deployment introspection used by the UI to grey out engines it cannot use and
+ * to decide how large a file it may upload inline.
+ *
+ * Reports *which* credentials exist — never the values themselves.
+ */
+
+import { ACCENT_CLASSES, ENGINES } from '@/lib/engines-meta';
+import { isBlobEnabled } from '@/lib/server/blob';
+import {
+  availableEngineOrder,
+  engineAvailability,
+  resolveEngineConfig,
+  serverConfig,
+} from '@/lib/server/config';
+import { KEYS_COOKIE, parseCredentialCookie } from '@/lib/server/credentials';
+import { jsonResponse } from '@/lib/server/http';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+export function GET(request) {
+  /*
+   * Availability is per visitor: a key saved on the settings page makes an
+   * engine usable for that browser even when the deployment has no env key.
+   */
+  const credentials = parseCredentialCookie(request.cookies.get(KEYS_COOKIE)?.value);
+  const availability = engineAvailability(credentials);
+  const order = availableEngineOrder(credentials);
+  const blobEnabled = isBlobEnabled();
+  const configs = Object.fromEntries(
+    ENGINES.map((engine) => [engine.id, resolveEngineConfig(engine.id, credentials)]),
+  );
+
+  return jsonResponse({
+    ok: true,
+    configured: order.length > 0,
+    /** Full description of every supported engine, in failover order. */
+    engines: ENGINES.map((engine) => ({
+      id: engine.id,
+      label: engine.label,
+      available: availability[engine.id],
+      // An empty ASSEMBLYAI_MODEL means "use the account default", so fall back
+      // to the marketing name from the registry rather than rendering nothing.
+      model: configs[engine.id]?.model || engine.model,
+      configuredModel: serverConfig[engine.id]?.model || null,
+      /** Where this request's key comes from: `settings`, `environment` or none. */
+      keySource: credentials[engine.id]?.key
+        ? 'settings'
+        : credentials[engine.id]?.disabled
+          ? 'disabled'
+          : serverConfig[engine.id]?.apiKey
+            ? 'environment'
+            : null,
+      blurb: engine.blurb,
+      description: engine.description,
+      supportsRemoteUrl: engine.supportsRemoteUrl,
+      docsUrl: engine.docsUrl,
+      dashboardUrl: engine.dashboardUrl,
+      keyVar: engine.keyVar,
+      usage: engine.usage,
+      accent: engine.accent,
+      // Position in the chain; null when this deployment has no key for it.
+      position: order.indexOf(engine.id) >= 0 ? order.indexOf(engine.id) + 1 : null,
+      role: order.indexOf(engine.id) === 0 ? 'primary' : order.includes(engine.id) ? 'fallback' : null,
+    })),
+    engineOrder: order,
+    accents: ACCENT_CLASSES,
+    credentials: {
+      /** True when at least one key came from this browser's settings page. */
+      fromSettings: Object.values(credentials).some((entry) => entry?.key),
+      manageUrl: '/settings',
+    },
+    limits: {
+      /** Files at or below this size are streamed through the API route. */
+      maxUploadMb: serverConfig.upload.maxMb,
+      /** Hard platform ceiling (4.5 MB on Vercel) — exceeded never, by design. */
+      platformBodyLimitMb: serverConfig.runtime.platformBodyLimitMb,
+      requestsPerWindow: serverConfig.rateLimit.max,
+      windowSeconds: Math.round(serverConfig.rateLimit.windowMs / 1000),
+      maxDurationSeconds: serverConfig.runtime.maxDurationSec,
+    },
+    largeUploads: {
+      /**
+       * When true the browser may upload straight to Vercel Blob and hand the
+       * provider a URL, escaping the serverless body limit entirely.
+       */
+      enabled: blobEnabled,
+      provider: blobEnabled ? 'vercel-blob' : null,
+      maxUploadMb: blobEnabled ? serverConfig.blob.maxUploadMb : null,
+      endpoint: blobEnabled ? '/api/blob/upload' : null,
+      deletedAfterUse: serverConfig.blob.deleteAfterUse,
+    },
+    features: {
+      autoFallback: true,
+      clientFallbackToggle: serverConfig.allowClientFallbackOption,
+      fallbackOnEmptyTranscript: serverConfig.fallbackOnEmptyTranscript,
+      usagePanel: serverConfig.usage.enabled,
+    },
+    runtime: {
+      platform: serverConfig.runtime.isVercel ? 'vercel' : 'self-hosted',
+      nodeEnv: process.env.NODE_ENV ?? 'development',
+    },
+  });
+}
diff --git a/app/api/transcribe/route.js b/app/api/transcribe/route.js
new file mode 100644
index 0000000..b22095c
--- /dev/null
+++ b/app/api/transcribe/route.js
@@ -0,0 +1,658 @@
+/**
+ * POST /api/transcribe
+ * ---------------------------------------------------------------------------
+ * Server-side proxy for the speech-to-text engines.
+ *
+ * Responsibilities
+ *   1. Validate the incoming multipart request (present, correct type, size) —
+ *      or, when the browser uploaded straight to Vercel Blob to escape the
+ *      4.5 MB serverless body limit, validate the `audioUrl` instead.
+ *   2. Rate-limit per client so a runaway tab cannot drain provider credits.
+ *   3. Try the primary engine (Deepgram Nova-2).
+ *   4. On a *retryable* failure — rate limited (429), out of credit (402),
+ *      expired/invalid key (401), server error (5xx), timeout, network fault,
+ *      or an empty transcript — transparently retry with Gladia.
+ *   5. Return one normalised JSON shape, or a clear, user-safe error when both
+ *      engines fail.
+ *
+ * The API keys never leave this process: the browser only ever calls this URL.
+ */
+
+import {
+  ERROR_CODES,
+  TranscriptionError,
+  describeCode,
+  estimateAudioSeconds,
+  httpStatusFor,
+  transcribeWithAssemblyAI,
+  transcribeWithDeepgram,
+  transcribeWithGladia,
+  transcribeWithSpeechmatics,
+} from '@/lib/engines';
+import { ENGINE_MAP, normaliseEngineId } from '@/lib/engines-meta';
+import { deleteBlob, isBlobEnabled, isOwnBlobUrl } from '@/lib/server/blob';
+import {
+  engineAvailability,
+  hasAnyEngine,
+  resolveEngineConfig,
+  serverConfig,
+} from '@/lib/server/config';
+import { KEYS_COOKIE, parseCredentialCookie } from '@/lib/server/credentials';
+import { recordAttempt } from '@/lib/server/usage';
+import { checkRateLimit, clientIdentifier } from '@/lib/server/rate-limit';
+import { errorResponse, jsonResponse, redact } from '@/lib/server/http';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+/**
+ * Vercel function timeout. 60 s is the ceiling every plan supports (Hobby caps
+ * here; Pro and above allow more), so it is the safe default.
+ *
+ * On Pro/Enterprise you can raise BOTH of these to finish very long recordings:
+ *   1. this constant → 300
+ *   2. FUNCTION_BUDGET_MS → e.g. 285000 (must stay under the value above)
+ * `lib/server/config.js` clamps every provider timeout to fit the budget, so the
+ * route always has time to return real JSON instead of dying mid-request.
+ */
+export const maxDuration = 60;
+
+const ACCEPTED_EXTENSIONS = [
+  'mp3', 'mpga', 'wav', 'wave', 'm4a', 'mp4', 'mpeg', 'webm', 'ogg', 'oga',
+  'opus', 'flac', 'aac', 'amr', 'aiff', 'aif', '3gp', '3gpp', 'mkv', 'mov',
+];
+
+/** Audio/video MIME types both engines accept. */
+const ACCEPTED_MIME =
+  /^(audio|video)\/|^application\/(ogg|octet-stream)$|^audio\/(x-)?(m4a|mp4|mpeg|webm|ogg|opus|flac|aac|wav|amr|aiff|basic)$/i;
+
+export async function POST(request) {
+  /*
+   * Keys can come from the deployment's environment or from the visitor's own
+   * settings cookie (see lib/server/credentials.js). Read them once per request:
+   * the cookie wins, the environment is the fallback.
+   */
+  const credentials = parseCredentialCookie(request.cookies.get(KEYS_COOKIE)?.value);
+
+  /* ---------------------------------------------------------------------- */
+  /* 0. Fail fast when there is no usable credential at all                 */
+  /* ---------------------------------------------------------------------- */
+  if (!hasAnyEngine(credentials)) {
+    return errorResponse({
+      status: 503,
+      code: ERROR_CODES.MISSING_KEY,
+      message:
+        'No speech-to-text engine is configured. Add a key on the settings page (/settings), or set DEEPGRAM_API_KEY and friends in .env.local.',
+      hint: 'Open /settings to paste a key, or add one to .env.local and restart the server.',
+    });
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* 1. Rate limit                                                          */
+  /* ---------------------------------------------------------------------- */
+  const limit = checkRateLimit(clientIdentifier(request), serverConfig.rateLimit);
+  if (!limit.allowed) {
+    return errorResponse({
+      status: 429,
+      code: ERROR_CODES.RATE_LIMITED,
+      message: `Too many transcription requests from this client. Please retry in ${limit.retryAfterSeconds}s.`,
+      extraHeaders: {
+        'Retry-After': String(limit.retryAfterSeconds),
+        'X-RateLimit-Limit': String(limit.limit),
+        'X-RateLimit-Remaining': '0',
+      },
+    });
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* 2. Reject oversized bodies before buffering them                       */
+  /* ---------------------------------------------------------------------- */
+  const declaredLength = Number(request.headers.get('content-length') || 0);
+  if (declaredLength && declaredLength > serverConfig.upload.maxBytes * 1.05) {
+    return errorResponse({
+      status: 413,
+      code: ERROR_CODES.BAD_REQUEST,
+      message: tooLargeMessage(declaredLength),
+    });
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* 3. Parse the request and resolve the audio source                      */
+  /* ---------------------------------------------------------------------- */
+  const parsed = await parseRequest(request);
+  if (parsed.error) return parsed.error;
+
+  const { getField, buffer, filename, contentType, audioUrl } = parsed;
+
+  /* ---------------------------------------------------------------------- */
+  /* 4. Work out which engines to attempt, in order                         */
+  /* ---------------------------------------------------------------------- */
+  const requestedEngine = normaliseEngineId(getField('engine'));
+  const wantsFallback =
+    !serverConfig.allowClientFallbackOption ||
+    readBoolean(getField('fallback'), true);
+
+  const availability = engineAvailability(credentials);
+  const plan = buildEnginePlan({ requestedEngine, wantsFallback, availability });
+
+  if (!plan.length) {
+    return errorResponse({
+      status: 503,
+      code: ERROR_CODES.MISSING_KEY,
+      message: describeUnavailableSelection({ requestedEngine, availability }),
+    });
+  }
+
+  const language = normaliseLanguage(getField('language'));
+  const clientDuration = Number.parseFloat(String(getField('durationSeconds') ?? ''));
+  const audio = audioUrl ? { url: audioUrl, filename } : { buffer, contentType, filename };
+
+  /* ---------------------------------------------------------------------- */
+  /* 5. Run the plan, collecting an attempt trail as we go                  */
+  /* ---------------------------------------------------------------------- */
+  const attempts = [];
+  let lastError = null;
+
+  for (const engine of plan) {
+    const index = plan.indexOf(engine);
+    const nextEngine = plan[index + 1];
+
+    try {
+      const result = await runEngine(engine, audio, { language, credentials });
+
+      if (result.text) {
+        attempts.push(successEntry(engine, result));
+        recordAttempt(engine, {
+          ok: true,
+          audioSeconds:
+            result.duration ??
+            (Number.isFinite(clientDuration) && clientDuration > 0 ? clientDuration : null),
+          elapsedMs: result.elapsedMs ?? null,
+          usedFallback: plan.indexOf(engine) > 0,
+        });
+        await releaseSource(audioUrl);
+        return jsonResponse(
+          buildSuccessBody({
+            result,
+            attempts,
+            plan,
+            engine,
+            buffer,
+            contentType,
+            clientDuration,
+          }),
+        );
+      }
+
+      // The request succeeded but produced no speech. Another engine is often
+      // able to hear what the first one could not, so treat this as retryable.
+      const empty = new TranscriptionError(
+        ERROR_CODES.EMPTY_TRANSCRIPT,
+        `${engine} returned an empty transcript.`,
+        {
+          provider: engine,
+          userMessage: describeCode(ERROR_CODES.EMPTY_TRANSCRIPT),
+        },
+      );
+      attempts.push(failureEntry(engine, empty));
+      recordAttempt(engine, { ok: false, code: ERROR_CODES.EMPTY_TRANSCRIPT });
+      lastError = empty;
+
+      if (nextEngine && serverConfig.fallbackOnEmptyTranscript) {
+        log(`[transcribe] ${engine} returned no speech — trying ${nextEngine}`);
+        continue;
+      }
+      break;
+    } catch (error) {
+      const failure =
+        error instanceof TranscriptionError
+          ? error
+          : new TranscriptionError(
+              ERROR_CODES.PROVIDER_ERROR,
+              redact(String(error?.message || error)),
+              { provider: engine },
+            );
+
+      attempts.push(failureEntry(engine, failure));
+      recordAttempt(engine, { ok: false, code: failure.code });
+      lastError = failure;
+
+      log(`[transcribe] ${engine} failed (${failure.code}) — ${failure.message}`);
+
+      // Non-retryable failures (corrupt or unsupported audio) would fail on the
+      // fallback engine too, so stop and report immediately.
+      if (!failure.retryable) break;
+
+      if (nextEngine) log(`[transcribe] falling back to ${nextEngine}`);
+    }
+  }
+
+  /* ---------------------------------------------------------------------- */
+  /* 6. Everything failed — explain it clearly                              */
+  /* ---------------------------------------------------------------------- */
+  await releaseSource(audioUrl);
+
+  const code = lastError?.code || ERROR_CODES.PROVIDER_ERROR;
+  const bothTried = attempts.length > 1;
+
+  // The raw provider message is logged above; the browser gets codes plus
+  // user-safe reasons. Developers still see the gory detail outside production.
+  return errorResponse({
+    status: httpStatusFor(lastError),
+    code,
+    message: buildFailureMessage({ code, lastError, attempts, bothTried, requestedEngine }),
+    detail: serverConfig.isProduction ? undefined : lastError?.message,
+    attempts: attempts.map(({ detail: _detail, ...rest }) => rest),
+  });
+}
+
+/* -------------------------------------------------------------------------- */
+/* Helpers                                                                     */
+/* -------------------------------------------------------------------------- */
+
+/**
+ * Parse either multipart/form-data (small clip, sent inline) or a JSON body
+ * carrying `audioUrl` (large clip, already in Vercel Blob).
+ *
+ * @returns {Promise<{error?: Response, form?: FormData, buffer?: Buffer|null,
+ *                    filename?: string, contentType?: string, audioUrl?: string|null}>}
+ */
+async function parseRequest(request) {
+  const contentTypeHeader = request.headers.get('content-type') || '';
+
+  if (contentTypeHeader.includes('application/json')) {
+    let payload;
+    try {
+      payload = await request.json();
+    } catch {
+      return {
+        error: errorResponse({
+          status: 400,
+          code: ERROR_CODES.BAD_REQUEST,
+          message: 'The JSON body could not be parsed.',
+        }),
+      };
+    }
+    const values = payload ?? {};
+    return resolveRemoteSource(values, (key) => values[key]);
+  }
+
+  let form;
+  try {
+    form = await request.formData();
+  } catch (error) {
+    return {
+      error: errorResponse({
+        status: 400,
+        code: ERROR_CODES.BAD_REQUEST,
+        message:
+          'The request body could not be read. Send the audio as multipart/form-data under the "audio" field, or as JSON with an "audioUrl".',
+        detail: redact(String(error?.message || error)),
+      }),
+    };
+  }
+
+  // A multipart request can still describe a remote object (the studio uses
+  // this so it always sends the settings alongside the source).
+  const remoteUrl = form.get('audioUrl');
+  if (typeof remoteUrl === 'string' && remoteUrl) {
+    return resolveRemoteSource(
+      { audioUrl: remoteUrl, filename: form.get('filename') },
+      (key) => form.get(key),
+    );
+  }
+
+  const file = form.get('audio') ?? form.get('file');
+  if (!file || typeof file === 'string' || typeof file.arrayBuffer !== 'function') {
+    return {
+      error: errorResponse({
+        status: 400,
+        code: ERROR_CODES.BAD_REQUEST,
+        message: 'No audio file was received. Attach it as the "audio" form field.',
+      }),
+    };
+  }
+
+  if (file.size === 0) {
+    return {
+      error: errorResponse({
+        status: 400,
+        code: ERROR_CODES.BAD_REQUEST,
+        message: 'The uploaded audio file is empty.',
+      }),
+    };
+  }
+
+  if (file.size > serverConfig.upload.maxBytes) {
+    return {
+      error: errorResponse({
+        status: 413,
+        code: ERROR_CODES.BAD_REQUEST,
+        message: tooLargeMessage(file.size),
+      }),
+    };
+  }
+
+  const filename = typeof file.name === 'string' && file.name ? file.name : 'audio';
+  const fileType =
+    file.type || guessContentTypeFromName(filename) || 'application/octet-stream';
+  const extension = filename.includes('.') ? filename.split('.').pop().toLowerCase() : '';
+
+  if (!ACCEPTED_MIME.test(fileType) && !ACCEPTED_EXTENSIONS.includes(extension)) {
+    return {
+      error: errorResponse({
+        status: 415,
+        code: ERROR_CODES.BAD_REQUEST,
+        message: `${fileType || 'That file type'} is not a supported audio format. Try MP3, WAV, M4A, WebM, OGG, FLAC or AAC.`,
+      }),
+    };
+  }
+
+  try {
+    return {
+      getField: (key) => form.get(key),
+      buffer: Buffer.from(await file.arrayBuffer()),
+      filename,
+      contentType: fileType,
+      audioUrl: null,
+    };
+  } catch {
+    return {
+      error: errorResponse({
+        status: 400,
+        code: ERROR_CODES.BAD_REQUEST,
+        message: 'The uploaded audio could not be read into memory.',
+      }),
+    };
+  }
+}
+
+/**
+ * Validate an `audioUrl` carrying caller-supplied remote audio.
+ *
+ * @param {{ audioUrl?: string, filename?: string }} payload
+ * @param {(key: string) => unknown} getField reads the remaining request settings
+ */
+function resolveRemoteSource(payload, getField) {
+  const audioUrl = typeof payload.audioUrl === 'string' ? payload.audioUrl.trim() : '';
+
+  if (!audioUrl) {
+    return {
+      error: errorResponse({
+        status: 400,
+        code: ERROR_CODES.BAD_REQUEST,
+        message: 'The "audioUrl" field is required when sending JSON.',
+      }),
+    };
+  }
+
+  if (!isOwnBlobUrl(audioUrl)) {
+    return {
+      error: errorResponse({
+        status: 400,
+        code: ERROR_CODES.BAD_REQUEST,
+        message:
+          'Only audio uploaded through this app’s Vercel Blob store can be fetched by URL. Upload the file instead.',
+      }),
+    };
+  }
+
+  const filename =
+    (typeof payload.filename === 'string' && payload.filename) ||
+    decodeURIComponent(audioUrl.split('/').pop() || 'audio');
+
+  return { getField, buffer: null, filename, contentType: 'audio/*', audioUrl };
+}
+
+/**
+ * Delete the uploaded object once transcription is over. `deleteAfterUse` can
+ * be switched off, but leaving it on keeps the promise that nothing is stored.
+ */
+async function releaseSource(audioUrl) {
+  if (!audioUrl || !serverConfig.blob.deleteAfterUse) return;
+  await deleteBlob(audioUrl);
+}
+
+/**
+ * Dispatch to the right provider adapter.
+ *
+ * Every adapter receives the same normalised input — either bytes or a remote
+ * URL — and returns the same normalised output, so adding an engine is a matter
+ * of adding one case here plus one entry in `lib/engines-meta.js`.
+ */
+async function runEngine(engine, audio, { language, credentials = {} }) {
+  const config = resolveEngineConfig(engine, credentials) ?? {};
+
+  switch (engine) {
+    case 'deepgram':
+      return transcribeWithDeepgram(audio, {
+        apiKey: config.apiKey,
+        model: config.model,
+        timeoutMs: config.timeoutMs,
+        baseUrl: config.baseUrl,
+        language,
+      });
+    case 'gladia':
+      return transcribeWithGladia(audio, {
+        apiKey: config.apiKey,
+        timeoutMs: config.timeoutMs,
+        pollTimeoutMs: config.pollTimeoutMs,
+        pollIntervalMs: config.pollIntervalMs,
+        baseUrl: config.baseUrl,
+        language,
+      });
+    case 'assemblyai':
+      return transcribeWithAssemblyAI(audio, {
+        apiKey: config.apiKey,
+        model: config.model,
+        timeoutMs: config.timeoutMs,
+        pollTimeoutMs: config.pollTimeoutMs,
+        pollIntervalMs: config.pollIntervalMs,
+        baseUrl: config.baseUrl,
+        language,
+      });
+    case 'speechmatics':
+      return transcribeWithSpeechmatics(audio, {
+        apiKey: config.apiKey,
+        model: config.model,
+        timeoutMs: config.timeoutMs,
+        pollTimeoutMs: config.pollTimeoutMs,
+        pollIntervalMs: config.pollIntervalMs,
+        baseUrl: config.baseUrl,
+        language,
+      });
+    default:
+      throw new TranscriptionError(
+        ERROR_CODES.MISSING_KEY,
+        `Unknown engine "${engine}".`,
+        { provider: engine, retryable: false },
+      );
+  }
+}
+
+/**
+ * Engine order for this request.
+ *
+ * - `auto`            → the configured failover chain (`ENGINE_ORDER`), filtered
+ *                       down to the engines that actually have a key.
+ * - a pinned engine   → that engine first, then the rest of the chain as a
+ *                       safety net — unless the caller turned fallback off, in
+ *                       which case only the pinned engine runs.
+ *
+ * With four engines this means a request can survive three consecutive provider
+ * outages (for example: Deepgram rate-limited → Gladia out of credit →
+ * AssemblyAI 5xx → Speechmatics) before the user sees an error.
+ */
+function buildEnginePlan({ requestedEngine, wantsFallback, availability }) {
+  const chain = serverConfig.engineOrder.filter((engine) => availability[engine]);
+  if (!chain.length) return [];
+
+  if (requestedEngine === 'auto') return chain;
+
+  if (!availability[requestedEngine]) return [];
+  if (!wantsFallback) return [requestedEngine];
+
+  // Pinned engine first, then everything else in the configured order.
+  return [requestedEngine, ...chain.filter((engine) => engine !== requestedEngine)];
+}
+
+function normaliseLanguage(value) {
+  const language = String(value ?? '').trim().toLowerCase();
+  if (!language || language === 'auto') return '';
+  // Guard against query-string injection — language codes are short tokens.
+  return /^[a-z]{2}(-[a-z0-9]{2,8})?$/.test(language) ? language : '';
+}
+
+function readBoolean(value, fallback) {
+  if (value === null || value === undefined || value === '') return fallback;
+  return ['1', 'true', 'yes', 'on'].includes(String(value).toLowerCase());
+}
+
+function guessContentTypeFromName(filename) {
+  const extension = filename.split('.').pop()?.toLowerCase();
+  const map = {
+    mp3: 'audio/mpeg',
+    mpga: 'audio/mpeg',
+    wav: 'audio/wav',
+    wave: 'audio/wav',
+    m4a: 'audio/mp4',
+    mp4: 'audio/mp4',
+    mov: 'video/quicktime',
+    webm: 'audio/webm',
+    ogg: 'audio/ogg',
+    oga: 'audio/ogg',
+    opus: 'audio/opus',
+    flac: 'audio/flac',
+    aac: 'audio/aac',
+    amr: 'audio/amr',
+    aiff: 'audio/aiff',
+    aif: 'audio/aiff',
+    mkv: 'video/x-matroska',
+    '3gp': 'audio/3gpp',
+  };
+  return map[extension] ?? '';
+}
+
+function successEntry(engine, result) {
+  return {
+    engine,
+    ok: true,
+    model: result.model ?? null,
+    elapsedMs: result.elapsedMs ?? null,
+  };
+}
+
+function failureEntry(engine, error) {
+  return {
+    engine,
+    ok: false,
+    code: error.code,
+    status: error.status ?? null,
+    retryable: Boolean(error.retryable),
+    // Server logs get the detail; the browser gets a short reason.
+    reason: describeCode(error.code),
+    detail: error.message,
+  };
+}
+
+function buildSuccessBody({
+  result,
+  attempts,
+  plan,
+  engine,
+  buffer,
+  contentType,
+  clientDuration,
+}) {
+  const fallbackUsed = plan.indexOf(engine) > 0;
+  const audioSeconds =
+    Number.isFinite(clientDuration) && clientDuration > 0
+      ? Math.round(clientDuration)
+      : buffer
+        ? estimateAudioSeconds(buffer.byteLength, contentType)
+        : null;
+
+  const warnings = [];
+  if (fallbackUsed) {
+    const primaryFailure = attempts.find((attempt) => !attempt.ok);
+    warnings.push(
+      `The primary engine was unavailable (${primaryFailure?.code ?? 'ERROR'}), so this transcript came from ${engine}.`,
+    );
+  }
+
+  return {
+    ok: true,
+    text: result.text,
+    engine: result.engine ?? engine,
+    model: result.model ?? null,
+    language: result.language ?? null,
+    confidence: result.confidence ?? null,
+    durationSeconds: result.duration ?? null,
+    audioSeconds,
+    requestId: result.requestId ?? null,
+    elapsedMs: result.elapsedMs ?? null,
+    fallbackUsed,
+    words: result.words ?? [],
+    segments: result.segments ?? [],
+    // `detail` is intentionally dropped: it is for server logs, not the client.
+    attempts: attempts.map(({ detail: _detail, ...rest }) => rest),
+    warnings,
+  };
+}
+
+function buildFailureMessage({ code, lastError, attempts, bothTried, requestedEngine }) {
+  if (code === ERROR_CODES.EMPTY_TRANSCRIPT) {
+    return 'No speech could be detected in that audio. Check that the recording is audible and not silent.';
+  }
+  if (code === ERROR_CODES.MISSING_KEY && requestedEngine !== 'auto') {
+    return describeUnavailableSelection({
+      requestedEngine,
+      availability: engineAvailability(),
+    });
+  }
+
+  // Name every engine that was tried, so a 4-deep chain reads honestly.
+  const engines = [...new Set(attempts.map((attempt) => attempt.engine))];
+  const reason = lastError?.userMessage || describeCode(code);
+
+  if (!bothTried || engines.length < 2) {
+    return `Transcription failed. ${reason}`;
+  }
+
+  const label = engines.length === 2 ? 'Both engines' : `All ${engines.length} engines`;
+  return `${label} failed (${engines.join(', ')}). ${reason}`;
+}
+
+function describeUnavailableSelection({ requestedEngine, availability }) {
+  const meta = ENGINE_MAP[requestedEngine];
+  if (meta && !availability[requestedEngine]) {
+    return `The ${meta.label} engine is selected but ${meta.keyVar} is not configured on this deployment.`;
+  }
+  return 'No speech-to-text engine is available for this request.';
+}
+
+/**
+ * One explanation for both oversize guards. When a Blob store is connected the
+ * advice is actionable ("this will work if you re-import it"), because a
+ * serverless body cap is not something the user can fix by trimming alone.
+ */
+function tooLargeMessage(bytes) {
+  const sizeLabel = bytes ? `That file is ${formatBytes(bytes)}. ` : 'That file is too large. ';
+  const inline = `The inline upload limit is ${serverConfig.upload.maxMb} MB.`;
+
+  if (isBlobEnabled()) {
+    return `${sizeLabel}${inline} Re-import it and the studio will route it through Vercel Blob storage instead, which has no such limit.`;
+  }
+  return `${sizeLabel}${inline} Trim the audio, raise MAX_UPLOAD_MB, or connect a Vercel Blob store for large files.`;
+}
+
+function formatBytes(bytes) {
+  if (bytes < 1024) return `${bytes} B`;
+  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
+  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
+}
+
+function log(message) {
+  // Keep production logs quiet unless something actually went wrong.
+  console.warn(message);
+}
diff --git a/app/api/usage/route.js b/app/api/usage/route.js
new file mode 100644
index 0000000..037c1f1
--- /dev/null
+++ b/app/api/usage/route.js
@@ -0,0 +1,79 @@
+/**
+ * GET /api/usage
+ * ---------------------------------------------------------------------------
+ * Consumption and remaining-limit report for every engine.
+ *
+ * ⚠️  This endpoint reports **account-level** billing information: how much
+ * audio has been processed and, where the provider exposes it, how much credit
+ * is left. It contains no secrets, but it is still business data — so it is
+ * guarded three ways:
+ *
+ *   1. `ENABLE_USAGE_PANEL=false` disables it completely (recommended on any
+ *      public deployment that does not have authentication in front of it).
+ *   2. Cross-site browser requests are refused via `Sec-Fetch-Site`, so a
+ *      malicious page cannot read your usage figures.
+ *   3. It shares the same per-IP rate limit as transcription.
+ *
+ * Figures are cached briefly (USAGE_CACHE_SEC) because they are informational.
+ */
+
+import { engineAvailability, serverConfig } from '@/lib/server/config';
+import { KEYS_COOKIE, parseCredentialCookie } from '@/lib/server/credentials';
+import { buildUsageReport } from '@/lib/server/usage';
+import { checkRateLimit, clientIdentifier } from '@/lib/server/rate-limit';
+import { errorResponse, jsonResponse } from '@/lib/server/http';
+import { ERROR_CODES } from '@/lib/engines';
+
+export const runtime = 'nodejs';
+export const dynamic = 'force-dynamic';
+
+export async function GET(request) {
+  if (!serverConfig.usage.enabled) {
+    return errorResponse({
+      status: 404,
+      code: ERROR_CODES.BAD_REQUEST,
+      message:
+        'The usage report is disabled on this deployment (ENABLE_USAGE_PANEL=false).',
+    });
+  }
+
+  // Browser-initiated cross-site reads are always blocked; same-origin calls
+  // (the studio) and non-browser clients (curl, scripts) are allowed.
+  const fetchSite = request.headers.get('sec-fetch-site');
+  if (fetchSite && !['same-origin', 'same-site', 'none'].includes(fetchSite)) {
+    return errorResponse({
+      status: 403,
+      code: ERROR_CODES.AUTH,
+      message: 'Cross-site requests for usage data are not allowed.',
+    });
+  }
+
+  const limit = checkRateLimit(`usage:${clientIdentifier(request)}`, {
+    max: Math.max(serverConfig.rateLimit.max, 60),
+    windowMs: serverConfig.rateLimit.windowMs,
+  });
+  if (!limit.allowed) {
+    return errorResponse({
+      status: 429,
+      code: ERROR_CODES.RATE_LIMITED,
+      message: `Too many usage requests. Please retry in ${limit.retryAfterSeconds}s.`,
+      extraHeaders: { 'Retry-After': String(limit.retryAfterSeconds) },
+    });
+  }
+
+  // Usage follows the same credential rules as transcription: a key saved on the
+  // settings page reports *that* account's figures, not the deployment's.
+  const credentials = parseCredentialCookie(request.cookies.get(KEYS_COOKIE)?.value);
+  const availability = engineAvailability(credentials);
+  const report = await buildUsageReport({ availability, credentials });
+
+  return jsonResponse({
+    ok: true,
+    ...report,
+    rates: {
+      requestsPerWindow: serverConfig.rateLimit.max,
+      windowSeconds: Math.round(serverConfig.rateLimit.windowMs / 1000),
+    },
+    engineOrder: serverConfig.engineOrder.filter((id) => availability[id]),
+  });
+}
diff --git a/app/engines/page.js b/app/engines/page.js
