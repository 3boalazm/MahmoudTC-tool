@@ -0,0 +1,149 @@
+/**
+ * app/usage/page.js
+ * ---------------------------------------------------------------------------
+ * "How much have I used, and how much is left?" — the full explanation, plus
+ * the live report. The honesty rules are enforced server-side in
+ * `lib/server/usage.js`: a provider that publishes nothing gets a card that
+ * says so rather than a made-up number.
+ */
+
+import Link from 'next/link';
+
+import UsagePanel from '@/components/UsagePanel.js';
+import { LayersIcon, ShieldIcon, WaveIcon } from '@/components/Icons.js';
+import { ENGINES } from '@/lib/engines-meta.js';
+import { availableEngineOrder, engineAvailability, serverConfig } from '@/lib/server/config.js';
+import { getServerI18n } from '@/lib/i18n/server.js';
+
+export async function generateMetadata() {
+  const { t } = await getServerI18n();
+  return {
+    title: t('usage.metaTitle'),
+    description: t('usage.metaDescription'),
+  };
+}
+
+export default async function UsagePage() {
+  const { t } = await getServerI18n();
+  const availability = engineAvailability();
+  const order = availableEngineOrder();
+
+  /** Exactly the shape the studio passes to the same component. */
+  const engines = ENGINES.map((engine) => ({
+    id: engine.id,
+    label: engine.label,
+    model: serverConfig[engine.id]?.model || engine.model,
+    configuredModel: serverConfig[engine.id]?.model || null,
+    available: Boolean(availability[engine.id]),
+    accent: engine.accent,
+    usage: engine.usage,
+    keyVar: engine.keyVar,
+    dashboardUrl: engine.dashboardUrl,
+    position: order.indexOf(engine.id) >= 0 ? order.indexOf(engine.id) + 1 : null,
+  }));
+
+  return (
+    <main className="mx-auto w-full max-w-6xl px-4 pb-16 pt-10 sm:px-6 lg:px-8">
+      <header className="animate-rise max-w-2xl">
+        <h1 className="text-3xl font-semibold tracking-tight text-ink-100 sm:text-4xl">
+          {t('usage.heading')}
+        </h1>
+        <p className="mt-2 text-sm leading-relaxed text-ink-400">{t('usage.body')}</p>
+      </header>
+
+      <div className="mt-8">
+        <UsagePanel
+          engines={engines}
+          engineOrder={order}
+          enabled={serverConfig.usage.enabled}
+        />
+      </div>
+
+      <section className="mt-10 grid gap-4 lg:grid-cols-2">
+        <article className="glass-panel rounded-4xl p-5">
+          <h2 className="flex items-center gap-2 text-base font-semibold text-ink-100">
+            <ShieldIcon className="size-4 text-mint-400" />
+            {t('usage.provenance')}
+          </h2>
+          <ul className="mt-4 space-y-3 text-[12px] leading-relaxed text-ink-400">
+            <li>
+              <span className="font-semibold text-ink-300">
+                {t('usage.provenanceLocalTitle')}
+              </span>{' '}
+              {t('usage.provenanceLocal')}
+            </li>
+            <li>
+              <span className="font-semibold text-ink-300">
+                {t('usage.provenanceProviderTitle')}
+              </span>{' '}
+              {t('usage.provenanceProvider', {
+                minutes: Math.round(serverConfig.usage.cacheSeconds / 60),
+              })}
+            </li>
+            <li>
+              <span className="font-semibold text-ink-300">
+                {t('usage.provenanceMissingTitle')}
+              </span>{' '}
+              {t('usage.provenanceMissing')}
+            </li>
+          </ul>
+          <p className="mt-4 rounded-2xl border border-amber-500/25 bg-amber-500/10 px-3.5 py-2.5 text-[11px] leading-relaxed text-amber-400">
+            {t('usage.provenanceWarning', { var: 'ENABLE_USAGE_PANEL=false' })}
+          </p>
+        </article>
+
+        <article className="glass-panel rounded-4xl p-5">
+          <h2 className="flex items-center gap-2 text-base font-semibold text-ink-100">
+            <LayersIcon className="size-4 text-iris-300" />
+            {t('usage.period')}
+          </h2>
+          <p className="mt-2 text-[12px] leading-relaxed text-ink-400">
+            {t('usage.panelSubtitle', { days: serverConfig.usage.periodDays })}
+          </p>
+
+          <dl className="mt-4 space-y-2 text-[12px]">
+            {ENGINES.map((engine) => (
+              <div
+                key={engine.id}
+                className="flex items-center justify-between gap-3 rounded-2xl border border-ink-500/15 bg-surface-1/60 px-3.5 py-2"
+              >
+                <dt className="flex items-center gap-2 text-ink-300">
+                  <WaveIcon
+                    className={`size-3.5 ${
+                      engine.accent === 'iris'
+                        ? 'text-iris-300'
+                        : engine.accent === 'mint'
+                          ? 'text-mint-400'
+                          : engine.accent === 'amber'
+                            ? 'text-amber-400'
+                            : 'text-rose-400'
+                    }`}
+                  />
+                  {engine.label}
+                </dt>
+                <dd className="font-mono text-[11px] text-ink-500">
+                  {engine.usage === 'balance+usage'
+                    ? t('engines.usageDeepgram')
+                    : engine.usage === 'usage'
+                      ? t('engines.usageSpeechmatics')
+                      : t('engines.usageNone')}
+                </dd>
+              </div>
+            ))}
+          </dl>
+
+          <p className="mt-4 font-mono text-[10px] text-ink-500">
+            {t('usage.chainLabel', { chain: order.join(' → ') || '—' })}
+          </p>
+
+          <Link
+            href="/studio"
+            className="mt-4 inline-flex items-center gap-2 rounded-2xl bg-iris-500 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-iris-400"
+          >
+            {t('home.ctaPrimary')}
+          </Link>
+        </article>
+      </section>
+    </main>
+  );
+}
diff --git a/components/AudioSourceCard.js b/components/AudioSourceCard.js
new file mode 100644
index 0000000..e4a8465
--- /dev/null
+++ b/components/AudioSourceCard.js
@@ -0,0 +1,457 @@
+'use client';
+
+/**
+ * components/AudioSourceCard.js
+ * ---------------------------------------------------------------------------
+ * "Where is the audio coming from?" — file upload or microphone recording.
+ * Both routes end in the same place: an in-memory clip handed to the parent,
+ * ready to POST to `/api/transcribe`.
+ */
+
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+import { LevelMeter, Waveform } from '@/components/Waveform';
+import {
+  AlertIcon,
+  ClockIcon,
+  FileAudioIcon,
+  MicIcon,
+  StopIcon,
+  TrashIcon,
+  UploadIcon,
+  WaveIcon,
+  XIcon,
+} from '@/components/Icons';
+import { useI18n } from '@/components/providers/I18nProvider.js';
+import { useRecorder } from '@/hooks/useRecorder';
+import { formatBytes, formatDuration } from '@/lib/client/format';
+
+const FILE_ACCEPT =
+  'audio/*,video/mp4,.mp3,.m4a,.wav,.webm,.ogg,.oga,.opus,.flac,.aac,.amr,.aiff,.aif,.mp4,.mov';
+
+export default function AudioSourceCard({
+  audio,
+  peaks,
+  isDecoding,
+  onLoad,
+  onClear,
+  disabled = false,
+  maxUploadMb = 25,
+  /** { enabled, maxUploadMb } — large files go browser → Vercel Blob directly. */
+  largeUploads = { enabled: false },
+  onBusyChange,
+}) {
+  const { t } = useI18n();
+  const [tab, setTab] = useState('file');
+  const [isDragging, setIsDragging] = useState(false);
+  const [fileError, setFileError] = useState(null);
+  const inputRef = useRef(null);
+
+  const recorder = useRecorder();
+
+  /**
+   * What the picker may accept. With a Blob store connected the ceiling becomes
+   * the store's limit, because oversized files bypass the function entirely;
+   * otherwise it is the serverless-safe inline limit.
+   */
+  const effectiveMaxMb = largeUploads.enabled
+    ? Math.max(maxUploadMb, largeUploads.maxUploadMb ?? maxUploadMb)
+    : maxUploadMb;
+
+  /* Tell the parent when recording is in progress so it can lock the UI. */
+  useEffect(() => {
+    onBusyChange?.(recorder.isRecording);
+  }, [recorder.isRecording, onBusyChange]);
+
+  /* ------------------------------------------------------------------ file */
+  const acceptFile = useCallback(
+    (file) => {
+      if (!file) return;
+      setFileError(null);
+
+      if (file.size === 0) {
+        setFileError(t('source.emptyFile'));
+        return;
+      }
+      if (file.size > effectiveMaxMb * 1024 * 1024) {
+        setFileError(
+          [
+            `${formatBytes(file.size)} — ${t('source.tooLarge', { size: effectiveMaxMb })}`,
+            largeUploads.enabled ? '' : t('source.tooLargeHint'),
+          ]
+            .filter(Boolean)
+            .join(' '),
+        );
+        return;
+      }
+      if (file.type && !/^(audio|video)\//.test(file.type) && !/\.[a-z0-9]+$/i.test(file.name)) {
+        setFileError(t('source.wrongType'));
+        return;
+      }
+
+      onLoad(file, {
+        name: file.name,
+        mimeType: file.type || 'application/octet-stream',
+        origin: 'file',
+      });
+    },
+    [effectiveMaxMb, largeUploads.enabled, onLoad, t],
+  );
+
+  /* Adopt a finished recording automatically — no extra click needed. */
+  const adoptedUrlRef = useRef(null);
+  useEffect(() => {
+    const captured = recorder.recording;
+    if (!captured || adoptedUrlRef.current === captured.url) return;
+    adoptedUrlRef.current = captured.url;
+    onLoad(captured.blob, {
+      name: `recording-${new Date().toISOString().slice(11, 19).replace(/:/g, '')}.${captured.extension}`,
+      mimeType: captured.mimeType,
+      durationSeconds: captured.durationSeconds,
+      origin: 'recording',
+    });
+  }, [recorder.recording, onLoad]);
+
+  const clearAll = useCallback(() => {
+    adoptedUrlRef.current = null;
+    recorder.discard();
+    setFileError(null);
+    onClear();
+    if (inputRef.current) inputRef.current.value = '';
+  }, [onClear, recorder]);
+
+  const isLocked = disabled || recorder.isRecording;
+  const isActive = recorder.status === 'recording' || recorder.status === 'paused';
+
+  return (
+    <section
+      id="source"
+      className="glass-panel animate-rise rounded-4xl p-5 shadow-[0_28px_80px_-40px_rgba(0,0,0,0.9)] sm:p-6"
+      aria-labelledby="source-heading"
+    >
+      <header className="flex flex-wrap items-center justify-between gap-3">
+        <div className="flex items-center gap-3">
+          <span className="grid size-10 place-items-center rounded-2xl bg-iris-500/15 text-iris-300 ring-1 ring-iris-400/25">
+            <WaveIcon className="size-5" />
+          </span>
+          <div>
+            <h2 id="source-heading" className="text-base font-semibold text-ink-100">
+              {t('source.heading')}
+            </h2>
+            <p className="text-sm text-ink-400">{t('studio.subheading')}</p>
+          </div>
+        </div>
+
+        {audio ? (
+          <button
+            type="button"
+            onClick={clearAll}
+            disabled={disabled}
+            className="inline-flex items-center gap-2 rounded-xl border border-ink-500/25 px-3 py-1.5 text-xs font-medium text-ink-300 transition hover:border-rose-400/40 hover:text-rose-400 disabled:cursor-not-allowed disabled:opacity-40"
+          >
+            <TrashIcon className="size-3.5" />
+            {t('source.clear')}
+          </button>
+        ) : null}
+      </header>
+
+      {/* ---------------------------------------------------------- tabs */}
+      <div
+        role="tablist"
+        aria-label={t('source.tabsLabel')}
+        className="mt-5 grid grid-cols-2 gap-1.5 rounded-2xl bg-surface-1/70 p-1.5 ring-1 ring-inset ring-ink-500/15"
+      >
+        <TabButton
+          active={tab === 'file'}
+          onClick={() => setTab('file')}
+          disabled={isLocked}
+          icon={<UploadIcon className="size-4" />}
+          label={t('source.uploadTab')}
+          hint="MP3, WAV, M4A, WebM…"
+          panelId="panel-file"
+        />
+        <TabButton
+          active={tab === 'record'}
+          onClick={() => setTab('record')}
+          disabled={isLocked}
+          icon={<MicIcon className="size-4" />}
+          label={t('source.recordTab')}
+          hint={t('source.recordHint')}
+          panelId="panel-record"
+        />
+      </div>
+
+      {/* ------------------------------------------------------ upload tab */}
+      <div
+        id="panel-file"
+        role="tabpanel"
+        aria-labelledby="tab-file"
+        hidden={tab !== 'file'}
+        className="mt-4"
+      >
+        <div
+          onDragOver={(event) => {
+            event.preventDefault();
+            if (!isLocked) setIsDragging(true);
+          }}
+          onDragLeave={() => setIsDragging(false)}
+          onDrop={(event) => {
+            event.preventDefault();
+            setIsDragging(false);
+            if (isLocked) return;
+            acceptFile(event.dataTransfer?.files?.[0]);
+          }}
+          className={`relative rounded-3xl border border-dashed px-6 py-9 text-center transition ${
+            isDragging
+              ? 'border-iris-400 bg-iris-500/10'
+              : 'border-ink-500/30 bg-surface-1/50 hover:border-iris-400/45 hover:bg-surface-2/60'
+          } ${isLocked ? 'opacity-60' : ''}`}
+        >
+          <input
+            ref={inputRef}
+            type="file"
+            accept={FILE_ACCEPT}
+            className="sr-only"
+            onChange={(event) => {
+              acceptFile(event.target.files?.[0]);
+              event.target.value = '';
+            }}
+          />
+          <div className="mx-auto grid size-14 place-items-center rounded-2xl bg-iris-500/15 text-iris-300 ring-1 ring-iris-400/25">
+            <UploadIcon className="size-6" />
+          </div>
+          <p className="mt-4 text-sm font-medium text-ink-200">
+            {t('source.dropTitle')}{' '}
+            <button
+              type="button"
+              disabled={isLocked}
+              onClick={() => inputRef.current?.click()}
+              className="rounded font-semibold text-iris-300 underline decoration-iris-400/40 decoration-2 underline-offset-4 transition hover:text-iris-200 disabled:cursor-not-allowed"
+            >
+              {t('source.browse')}
+            </button>
+          </p>
+          <p className="mt-2 text-xs leading-relaxed text-ink-400">
+            {t('source.formats')} · {effectiveMaxMb} MB
+          </p>
+          <p className="mt-1.5 text-[11px] text-ink-500">
+            {largeUploads.enabled
+              ? t('studio.footerBlob', {
+                  inline: maxUploadMb,
+                  max: largeUploads.maxUploadMb ?? maxUploadMb,
+                })
+              : t('source.maxSize', { size: effectiveMaxMb, blob: effectiveMaxMb })}
+          </p>
+        </div>
+
+        {fileError ? <InlineError message={fileError} /> : null}
+      </div>
+
+      {/* ------------------------------------------------------ record tab */}
+      <div
+        id="panel-record"
+        role="tabpanel"
+        aria-labelledby="tab-record"
+        hidden={tab !== 'record'}
+        className="mt-4"
+      >
+        {!recorder.isSupported ? (
+          <InlineError message={t('source.noMediaRecorder')} />
+        ) : (
+          <div className="rounded-3xl border border-ink-500/20 bg-surface-1/50 p-5">
+            <div className="flex flex-col items-center gap-5 sm:flex-row sm:items-center sm:justify-between">
+              <div className="flex items-center gap-4">
+                <button
+                  type="button"
+                  onClick={() => (isActive ? recorder.stop() : recorder.start())}
+                  disabled={disabled && !isActive}
+                  aria-label={isActive ? t('source.stop') : t('source.start')}
+                  className={`relative grid size-16 shrink-0 place-items-center rounded-full transition focus-visible:outline-offset-4 disabled:cursor-not-allowed disabled:opacity-50 ${
+                    isActive
+                      ? 'bg-rose-500 text-white'
+                      : 'bg-iris-500 text-white hover:bg-iris-400'
+                  }`}
+                >
+                  {isActive ? (
+                    <>
+                      <span className="absolute inset-0 animate-halo rounded-full bg-rose-500/45" />
+                      <StopIcon className="relative size-6" />
+                    </>
+                  ) : (
+                    <MicIcon className="size-6" />
+                  )}
+                </button>
+
+                <div>
+                  <p
+                    className="font-mono text-2xl font-semibold tabular-nums text-ink-100"
+                    aria-live="off"
+                  >
+                    {formatDuration(recorder.elapsed)}
+                  </p>
+                  <p className="text-xs text-ink-400" role="status">
+                    {recorder.status === 'requesting'
+                      ? t('source.permission')
+                      : recorder.status === 'paused'
+                        ? t('source.paused')
+                        : recorder.status === 'stopping'
+                          ? t('source.finishing')
+                          : recorder.status === 'recording'
+                            ? t('source.recording')
+                            : t('source.press')}
+                  </p>
+                </div>
+              </div>
+
+              <div className="flex items-center gap-2">
+                <button
+                  type="button"
+                  onClick={recorder.togglePause}
+                  disabled={!isActive || recorder.status === 'stopping'}
+                  className="rounded-xl border border-ink-500/25 px-3 py-2 text-xs font-medium text-ink-300 transition hover:border-iris-400/40 hover:text-ink-100 disabled:cursor-not-allowed disabled:opacity-40"
+                >
+                  {recorder.status === 'paused' ? t('source.resume') : t('source.pause')}
+                </button>
+                <button
+                  type="button"
+                  onClick={() => {
+                    recorder.stop();
+                  }}
+                  disabled={!isActive}
+                  className="rounded-xl border border-ink-500/25 px-3 py-2 text-xs font-medium text-ink-300 transition hover:border-rose-400/40 hover:text-rose-400 disabled:cursor-not-allowed disabled:opacity-40"
+                >
+                  {t('source.stop')}
+                </button>
+              </div>
+            </div>
+
+            <div className="mt-5">
+              <LevelMeter levels={recorder.levels} isActive={isActive} />
+              <p className="mt-2 text-center text-[11px] text-ink-500">{t('source.level')}</p>
+            </div>
+
+            {recorder.error ? (
+              <InlineError
+                message={t(`source.rec.${recorder.error}`)}
+                onDismiss={recorder.clearError}
+              />
+            ) : null}
+
+            {recorder.recording && audio?.origin === 'recording' ? (
+              <div className="mt-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-mint-500/25 bg-mint-500/10 px-4 py-3">
+                <p className="text-xs text-mint-400">
+                  {t('source.decoded')} · {formatDuration(recorder.recording.durationSeconds)}
+                </p>
+                <button
+                  type="button"
+                  onClick={() => {
+                    adoptedUrlRef.current = null;
+                    recorder.discard();
+                    onClear();
+                  }}
+                  className="inline-flex items-center gap-1.5 rounded-lg border border-mint-500/30 px-2.5 py-1 text-[11px] font-medium text-mint-400 transition hover:bg-mint-500/15"
+                >
+                  <XIcon className="size-3" />
+                  {t('source.recordTab')}
+                </button>
+              </div>
+            ) : null}
+          </div>
+        )}
+      </div>
+
+      {/* --------------------------------------------------- loaded audio */}
+      {audio ? (
+        <div className="mt-5 rounded-3xl border border-ink-500/20 bg-surface-1/60 p-4">
+          <div className="flex flex-wrap items-center justify-between gap-3">
+            <div className="flex min-w-0 items-center gap-3">
+              <span className="grid size-9 shrink-0 place-items-center rounded-xl bg-mint-500/15 text-mint-400 ring-1 ring-mint-500/25">
+                <FileAudioIcon className="size-4.5" />
+              </span>
+              <div className="min-w-0">
+                <p className="truncate text-sm font-medium text-ink-100" title={audio.name}>
+                  {audio.name}
+                </p>
+                <p className="flex items-center gap-2 text-[11px] text-ink-400">
+                  <span>{formatBytes(audio.size)}</span>
+                  <span aria-hidden="true">•</span>
+                  <span className="inline-flex items-center gap-1">
+                    <ClockIcon className="size-3" />
+                    {audio.durationSeconds
+                      ? formatDuration(audio.durationSeconds)
+                      : isDecoding
+                        ? t('common.loading')
+                        : '—'}
+                  </span>
+                  {audio.origin === 'recording' ? (
+                    <>
+                      <span aria-hidden="true">•</span>
+                      <span className="text-mint-400">{t('source.fromMic')}</span>
+                    </>
+                  ) : null}
+                </p>
+              </div>
+            </div>
+
+            <audio
+              src={audio.url}
+              controls
+              preload="metadata"
+              className="h-9 w-full max-w-[16rem]"
+              title={t('source.preview')}
+            />
+          </div>
+
+          <Waveform peaks={peaks} isDecoding={isDecoding} className="mt-4" height={52} />
+        </div>
+      ) : null}
+    </section>
+  );
+}
+
+function TabButton({ active, onClick, disabled, icon, label, hint, panelId }) {
+  return (
+    <button
+      type="button"
+      role="tab"
+      id={`tab-${panelId.replace('panel-', '')}`}
+      aria-selected={active}
+      aria-controls={panelId}
+      onClick={onClick}
+      disabled={disabled}
+      className={`flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-start transition disabled:cursor-not-allowed disabled:opacity-50 ${
+        active
+          ? 'bg-surface-3 text-ink-100 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]'
+          : 'text-ink-400 hover:bg-surface-2/70 hover:text-ink-200'
+      }`}
+    >
+      <span className={active ? 'text-iris-300' : ''}>{icon}</span>
+      <span className="min-w-0">
+        <span className="block text-sm font-medium">{label}</span>
+        <span className="block truncate text-[11px] text-ink-500">{hint}</span>
+      </span>
+    </button>
+  );
+}
+
+function InlineError({ message, onDismiss }) {
+  return (
+    <div
+      role="alert"
+      className="mt-3 flex items-start gap-2.5 rounded-2xl border border-rose-500/30 bg-rose-500/10 px-3.5 py-2.5 text-xs text-rose-400"
+    >
+      <AlertIcon className="mt-0.5 size-4 shrink-0" />
+      <p className="flex-1 leading-relaxed">{message}</p>
+      {onDismiss ? (
+        <button
+          type="button"
+          onClick={onDismiss}
+          aria-label={t('common.dismiss')}
+          className="rounded p-0.5 text-rose-400/80 transition hover:text-rose-400"
+        >
+          <XIcon className="size-3.5" />
+        </button>
+      ) : null}
+    </div>
+  );
+}
