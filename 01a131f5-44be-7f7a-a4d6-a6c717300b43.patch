diff --git a/lib/client/api.js b/lib/client/api.js
new file mode 100644
index 0000000..65f7509
--- /dev/null
+++ b/lib/client/api.js
@@ -0,0 +1,173 @@
+/**
+ * lib/client/api.js
+ * ---------------------------------------------------------------------------
+ * Thin client for the transcription API. Owns two contracts:
+ *
+ *   1. `requestTranscription` — POST /api/transcribe, with the audio either
+ *      inline (multipart) or as a remote `audioUrl` for large files.
+ *   2. `uploadToBlob` — browser → Vercel Blob direct upload, which is how a
+ *      file bigger than the serverless 4.5 MB body limit reaches the provider.
+ *
+ * Every failure is normalised into a `TranscriptionClientError`, so the UI never
+ * has to defensively parse provider payloads.
+ */
+
+export class TranscriptionClientError extends Error {
+  constructor(message, { code = 'CLIENT_ERROR', status = 0, attempts = [], detail } = {}) {
+    super(message);
+    this.name = 'TranscriptionClientError';
+    this.code = code;
+    this.status = status;
+    this.attempts = attempts;
+    this.detail = detail;
+  }
+}
+
+/**
+ * @param {object} params
+ * @param {Blob}   [params.audio]          recorded blob or selected File
+ * @param {string} [params.audioUrl]       Vercel Blob URL for large files
+ * @param {string} [params.filename]
+ * @param {'auto'|'deepgram'|'gladia'} [params.engine]
+ * @param {boolean} [params.fallback]      allow automatic engine failover
+ * @param {string} [params.language]       ISO-639-1 code or '' for auto
+ * @param {number} [params.durationSeconds]
+ * @param {AbortSignal} [params.signal]
+ */
+export async function requestTranscription({
+  audio,
+  audioUrl,
+  filename,
+  engine = 'auto',
+  fallback = true,
+  language = '',
+  durationSeconds,
+  signal,
+}) {
+  if (!audio && !audioUrl) {
+    throw new TranscriptionClientError('No audio was provided for transcription.', {
+      code: 'NO_AUDIO',
+    });
+  }
+
+  // Large-file mode: the bytes are already in Blob storage, so the route only
+  // needs a URL. Sending it as multipart keeps one code path on the server.
+  const body = new FormData();
+  if (audioUrl) {
+    body.append('audioUrl', audioUrl);
+    body.append('filename', filename || 'audio');
+  } else {
+    body.append('audio', audio, filename || 'audio.webm');
+  }
+  body.append('engine', engine);
+  body.append('fallback', fallback ? 'true' : 'false');
+  if (language) body.append('language', language);
+  if (Number.isFinite(durationSeconds) && durationSeconds > 0) {
+    body.append('durationSeconds', String(durationSeconds));
+  }
+
+  let response;
+  try {
+    response = await fetch('/api/transcribe', {
+      method: 'POST',
+      body,
+      signal,
+      headers: { Accept: 'application/json' },
+    });
+  } catch (error) {
+    if (error?.name === 'AbortError') {
+      throw new TranscriptionClientError('Transcription cancelled.', { code: 'ABORTED' });
+    }
+    throw new TranscriptionClientError(
+      'Could not reach the transcription service. Check your connection and try again.',
+      { code: 'NETWORK' },
+    );
+  }
+
+  let payload = null;
+  try {
+    payload = await response.json();
+  } catch {
+    payload = null;
+  }
+
+  if (!response.ok) {
+    const error = payload?.error ?? {};
+    throw new TranscriptionClientError(
+      error.message || `Transcription failed (HTTP ${response.status}).`,
+      {
+        code: error.code || 'PROVIDER_ERROR',
+        status: response.status,
+        attempts: error.attempts ?? [],
+        detail: error.detail,
+      },
+    );
+  }
+
+  if (!payload?.text) {
+    throw new TranscriptionClientError(
+      payload?.error?.message || 'No speech was detected in that audio.',
+      { code: payload?.error?.code || 'EMPTY_TRANSCRIPT', attempts: payload?.attempts ?? [] },
+    );
+  }
+
+  return payload;
+}
+
+/**
+ * Upload a large file straight to Vercel Blob.
+ *
+ * The file travels browser → Blob storage, never through a serverless function,
+ * which is what makes it immune to the 4.5 MB request-body cap. The SDK talks to
+ * `/api/blob/upload` only to exchange a short-lived token.
+ *
+ * @param {File|Blob} file
+ * @param {{ filename?: string, onProgress?: (fraction: number) => void, signal?: AbortSignal }} options
+ * @returns {Promise<string>} the public blob URL to hand to /api/transcribe
+ */
+export async function uploadToBlob(file, { filename, onProgress, signal } = {}) {
+  const pathname = sanitiseBlobPath(filename || file.name || 'audio.webm');
+
+  let upload;
+  try {
+    ({ upload } = await import('@vercel/blob/client'));
+  } catch {
+    throw new TranscriptionClientError(
+      'Large-file uploads are unavailable because the storage SDK is not installed.',
+      { code: 'BLOB_UNAVAILABLE' },
+    );
+  }
+
+  try {
+    const blob = await upload(pathname, file, {
+      access: 'public', // Deepgram and Gladia must be able to fetch the URL.
+      handleUploadUrl: '/api/blob/upload',
+      contentType: file.type || undefined,
+      abortSignal: signal,
+      onUploadProgress: ({ percentage }) => {
+        onProgress?.(Math.max(0, Math.min(1, (percentage ?? 0) / 100)));
+      },
+    });
+    return blob.url;
+  } catch (error) {
+    if (error?.name === 'AbortError') {
+      throw new TranscriptionClientError('Upload cancelled.', { code: 'ABORTED' });
+    }
+    throw new TranscriptionClientError(
+      error?.message ||
+        'The file could not be uploaded to storage. Try a smaller file or check the Blob store configuration.',
+      { code: 'BLOB_UPLOAD_FAILED' },
+    );
+  }
+}
+
+/** Keep the pathname tame: relative, no traversal, safe characters only. */
+function sanitiseBlobPath(name) {
+  const cleaned = String(name)
+    .replace(/^.*[\\/]/, '') // strip any directory part
+    .replace(/[^a-zA-Z0-9._-]+/g, '_')
+    .slice(-80);
+  const extension = cleaned.includes('.') ? '' : '.webm';
+  return `stt-uploads/${cleaned || 'audio'}${extension}`;
+}
+
diff --git a/lib/client/format.js b/lib/client/format.js
new file mode 100644
index 0000000..6fba716
--- /dev/null
+++ b/lib/client/format.js
@@ -0,0 +1,194 @@
+/**
+ * lib/client/format.js
+ * ---------------------------------------------------------------------------
+ * Presentation helpers shared by the client components. Pure functions only —
+ * safe to import from anywhere, easy to unit test.
+ */
+
+// Relative (not `@/`) so this module also runs under bare `node --test`.
+import { ENGINE_MAP } from '../engines-meta.js';
+
+/** 74 → "01:14", 3725 → "1:02:05" */
+export function formatDuration(totalSeconds) {
+  if (!Number.isFinite(totalSeconds) || totalSeconds < 0) return '00:00';
+  const seconds = Math.floor(totalSeconds % 60);
+  const minutes = Math.floor((totalSeconds / 60) % 60);
+  const hours = Math.floor(totalSeconds / 3600);
+  const pad = (value) => String(value).padStart(2, '0');
+  return hours > 0
+    ? `${hours}:${pad(minutes)}:${pad(seconds)}`
+    : `${pad(minutes)}:${pad(seconds)}`;
+}
+
+/** 1_234_567 → "1.2 MB" */
+export function formatBytes(bytes) {
+  if (!Number.isFinite(bytes) || bytes <= 0) return '0 KB';
+  const units = ['B', 'KB', 'MB', 'GB'];
+  const index = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)));
+  const value = bytes / 1024 ** index;
+  // Whole numbers stay whole ("2 KB"); fractions keep one decimal ("1.5 MB").
+  const rounded = Math.round(value * 10) / 10;
+  const pretty = Number.isInteger(rounded) ? String(rounded) : rounded.toFixed(1);
+  return `${pretty} ${units[index]}`;
+}
+
+/** 1250 → "1.3s" */
+export function formatElapsed(milliseconds) {
+  if (!Number.isFinite(milliseconds) || milliseconds <= 0) return '—';
+  if (milliseconds < 1000) return `${Math.round(milliseconds)}ms`;
+  return `${(milliseconds / 1000).toFixed(milliseconds < 10_000 ? 1 : 0)}s`;
+}
+
+/** Aggregate counts shown under the transcript. */
+export function analyseText(text) {
+  const value = typeof text === 'string' ? text : '';
+  const trimmed = value.trim();
+  const words = trimmed ? trimmed.split(/\s+/).filter(Boolean) : [];
+  const sentences = trimmed ? trimmed.split(/[.!?…]+(?:\s|$)/).filter((s) => s.trim()).length : 0;
+  const paragraphs = trimmed ? trimmed.split(/\n{2,}/).filter((s) => s.trim()).length : 0;
+  const readingSeconds = Math.round((words.length / 200) * 60); // 200 wpm
+  return {
+    characters: value.length,
+    charactersNoSpaces: value.replace(/\s/g, '').length,
+    words: words.length,
+    sentences,
+    paragraphs,
+    readingTime: formatDuration(readingSeconds),
+  };
+}
+
+/** `0.9134` → "91%" */
+export function formatConfidence(value) {
+  if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0) return null;
+  return `${Math.round(value * 100)}%`;
+}
+
+/**
+ * Turn an engine id into a human label. Engine names live in one place
+ * (`lib/engines-meta.js`) so a new provider never needs a second edit here.
+ */
+export function engineLabel(engine) {
+  if (engine === 'auto') return 'Auto';
+  if (!engine || engine === 'none') return '—';
+  return ENGINE_MAP[engine]?.label ?? engine;
+}
+
+/** "Deepgram Nova-2", falling back to just the engine name. */
+export function modelLabel(engine, model) {
+  if (engine === 'auto') return model ? `Auto · ${model}` : 'Auto';
+  const meta = ENGINE_MAP[engine];
+  if (!meta) return engineLabel(engine);
+  const pretty = model
+    ? meta.prettyModels?.[model] ?? model
+    : meta.shortModel ?? null;
+  return pretty ? `${meta.label} ${pretty}` : meta.label;
+}
+
+/** SRT timestamp: 00:00:01,250 */
+function srtTime(seconds) {
+  const safe = Number.isFinite(seconds) && seconds > 0 ? seconds : 0;
+  const hours = Math.floor(safe / 3600);
+  const minutes = Math.floor((safe / 60) % 60);
+  const secs = Math.floor(safe % 60);
+  const millis = Math.round((safe - Math.floor(safe)) * 1000);
+  const pad = (value, size = 2) => String(value).padStart(size, '0');
+  return `${pad(hours)}:${pad(minutes)}:${pad(secs)},${pad(millis, 3)}`;
+}
+
+/**
+ * Build an SRT subtitle file from the timed segments a provider returned.
+ * Returns `null` when the engine gave no timings (nothing useful to export).
+ */
+export function buildSrt(segments = []) {
+  const usable = segments.filter(
+    (segment) => segment?.text && Number.isFinite(segment.end) && segment.end > 0,
+  );
+  if (!usable.length) return null;
+
+  return usable
+    .map((segment, index) => {
+      const start = Number.isFinite(segment.start) ? segment.start : 0;
+      return [
+        String(index + 1),
+        `${srtTime(start)} --> ${srtTime(Math.max(segment.end, start + 0.4))}`,
+        segment.text.trim(),
+        '',
+      ].join('\n');
+    })
+    .join('\n');
+}
+
+/** Build a plain-text transcript with light paragraph wrapping. */
+export function buildPlainText(text, { wrapAt = 0 } = {}) {
+  const value = (text || '').trim();
+  if (!wrapAt) return value;
+  return value
+    .split(/\n{2,}/)
+    .map((paragraph) => {
+      const words = paragraph.split(/\s+/).filter(Boolean);
+      const lines = [];
+      let line = '';
+      for (const word of words) {
+        if ((line + ' ' + word).trim().length > wrapAt) {
+          lines.push(line.trim());
+          line = word;
+        } else {
+          line = `${line} ${word}`;
+        }
+      }
+      if (line.trim()) lines.push(line.trim());
+      return lines.join('\n');
+    })
+    .join('\n\n');
+}
+
+/** Trigger a browser download without leaking a link element. */
+export function downloadFile(filename, contents, mimeType = 'text/plain') {
+  const blob = new Blob([contents], { type: `${mimeType};charset=utf-8` });
+  const url = URL.createObjectURL(blob);
+  const anchor = document.createElement('a');
+  anchor.href = url;
+  anchor.download = filename;
+  document.body.appendChild(anchor);
+  anchor.click();
+  anchor.remove();
+  // Give the browser a tick to start the download before revoking.
+  setTimeout(() => URL.revokeObjectURL(url), 1_000);
+}
+
+/**
+ * Copy text to the clipboard, falling back to a hidden textarea on browsers
+ * (or non-HTTPS origins) where `navigator.clipboard` is unavailable.
+ */
+export async function copyToClipboard(text) {
+  const value = text ?? '';
+  if (typeof navigator !== 'undefined' && navigator.clipboard?.writeText) {
+    try {
+      await navigator.clipboard.writeText(value);
+      return true;
+    } catch {
+      /* fall through to the legacy path */
+    }
+  }
+  if (typeof document === 'undefined') return false;
+  try {
+    const textarea = document.createElement('textarea');
+    textarea.value = value;
+    textarea.setAttribute('readonly', '');
+    textarea.style.position = 'fixed';
+    textarea.style.opacity = '0';
+    document.body.appendChild(textarea);
+    textarea.select();
+    const ok = document.execCommand('copy');
+    textarea.remove();
+    return ok;
+  } catch {
+    return false;
+  }
+}
+
+/** Derive a tidy base filename for exports: "interview.m4a" → "interview". */
+export function baseName(name) {
+  const value = (name || 'transcript').replace(/\.[^./\\]+$/, '');
+  return value.replace(/[^\w\-. ]+/g, '_').slice(0, 60) || 'transcript';
+}
diff --git a/lib/engines-meta.js b/lib/engines-meta.js
new file mode 100644
index 0000000..0053bb6
--- /dev/null
+++ b/lib/engines-meta.js
@@ -0,0 +1,144 @@
+/**
+ * lib/engines-meta.js
+ * ---------------------------------------------------------------------------
+ * Presentation + capability metadata for every supported engine. Pure data, no
+ * secrets and no Node APIs, so both the server (API routes) and the browser
+ * (engine picker, usage panel) can import the exact same source of truth.
+ *
+ * `usage` describes how much account data a provider is willing to expose:
+ *   'balance+usage' — remaining credit and consumption (Deepgram)
+ *   'usage'         — consumption only (Speechmatics)
+ *   'none'          — nothing public; we fall back to local counters
+ */
+
+export const ENGINES = [
+  {
+    id: 'deepgram',
+    label: 'Deepgram',
+    model: 'Nova-2',
+    shortModel: 'Nova-2',
+    blurb: 'Fastest, most accurate',
+    description:
+      'Deepgram Nova-2 — smart formatting, punctuation, paragraph segmentation and word timestamps.',
+    docsUrl: 'https://developers.deepgram.com/docs/pre-recorded-audio',
+    dashboardUrl: 'https://console.deepgram.com/',
+    signupUrl: 'https://console.deepgram.com/signup',
+    keyVar: 'DEEPGRAM_API_KEY',
+    modelVar: 'DEEPGRAM_MODEL',
+    accent: 'iris',
+    supportsRemoteUrl: true,
+    usage: 'balance+usage',
+    usageNote: 'Remaining credit and audio hours via the Deepgram management API.',
+  },
+  {
+    id: 'gladia',
+    label: 'Gladia',
+    model: 'Solaria',
+    shortModel: 'Solaria',
+    blurb: 'High reliability, async jobs',
+    description:
+      'Gladia Solaria — upload, then create a job and poll it, with utterance-level timings.',
+    docsUrl: 'https://docs.gladia.io/api-reference/v2/transcription/init',
+    dashboardUrl: 'https://app.gladia.io/',
+    signupUrl: 'https://app.gladia.io/',
+    keyVar: 'GLADIA_API_KEY',
+    modelVar: null,
+    accent: 'mint',
+    supportsRemoteUrl: true,
+    usage: 'none',
+    usageNote: 'Gladia does not publish a usage or balance endpoint — local counters only.',
+  },
+  {
+    id: 'assemblyai',
