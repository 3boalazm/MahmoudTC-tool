diff --git a/public/sw.js b/public/sw.js
new file mode 100644
index 0000000..0f8534e
--- /dev/null
+++ b/public/sw.js
@@ -0,0 +1,117 @@
+/**
+ * public/sw.js — service worker for the installed app.
+ *
+ * Deliberately conservative: it caches the interface so the app opens instantly
+ * and works offline, and it never touches transcription requests.
+ *
+ *   navigations  → network first, cache fallback, /offline as the last resort
+ *   static assets → cache first (they are content-hashed by Next.js)
+ *   /api/*        → never cached, never replayed; a stale transcript would be
+ *                   worse than an honest error
+ */
+
+const VERSION = 'v3';
+const SHELL_CACHE = `stt-shell-${VERSION}`;
+const ASSET_CACHE = `stt-assets-${VERSION}`;
+
+const SHELL_URLS = [
+  '/',
+  '/studio',
+  '/engines',
+  '/usage',
+  '/faq',
+  '/offline',
+  '/manifest.webmanifest',
+  '/icons/icon-192.png',
+  '/icons/icon-512.png',
+  '/icons/apple-touch-icon.png',
+];
+
+self.addEventListener('install', (event) => {
+  event.waitUntil(
+    (async () => {
+      const cache = await caches.open(SHELL_CACHE);
+      // Individually, so one 404 cannot abort the whole install.
+      await Promise.all(
+        SHELL_URLS.map((url) => cache.add(new Request(url, { cache: 'reload' })).catch(() => null)),
+      );
+      await self.skipWaiting();
+    })(),
+  );
+});
+
+self.addEventListener('activate', (event) => {
+  event.waitUntil(
+    (async () => {
+      const keys = await caches.keys();
+      await Promise.all(
+        keys.filter((key) => key !== SHELL_CACHE && key !== ASSET_CACHE).map((key) => caches.delete(key)),
+      );
+      await self.clients.claim();
+    })(),
+  );
+});
+
+self.addEventListener('message', (event) => {
+  if (event.data === 'SKIP_WAITING') self.skipWaiting();
+});
+
+const isStaticAsset = (url) =>
+  url.pathname.startsWith('/_next/static/') ||
+  url.pathname.startsWith('/icons/') ||
+  /\.(?:css|js|png|jpg|jpeg|svg|webp|ico|woff2?)$/.test(url.pathname);
+
+/** Network first, falling back to whatever we cached, then to /offline. */
+async function handleNavigation(request) {
+  try {
+    const response = await fetch(request);
+    const cache = await caches.open(SHELL_CACHE);
+    cache.put(request, response.clone());
+    return response;
+  } catch {
+    const cached = (await caches.match(request)) || (await caches.match('/offline'));
+    return (
+      cached ||
+      new Response('<!doctype html><meta charset="utf-8"><title>Offline</title><p>You are offline.', {
+        headers: { 'content-type': 'text/html; charset=utf-8' },
+      })
+    );
+  }
+}
+
+/** Cache first for immutable build output. */
+async function handleAsset(request) {
+  const cached = await caches.match(request);
+  if (cached) return cached;
+
+  try {
+    const response = await fetch(request);
+    if (response.ok) {
+      const cache = await caches.open(ASSET_CACHE);
+      cache.put(request, response.clone());
+    }
+    return response;
+  } catch {
+    return new Response('', { status: 504, statusText: 'Offline' });
+  }
+}
+
+self.addEventListener('fetch', (event) => {
+  const { request } = event;
+  if (request.method !== 'GET') return;
+
+  const url = new URL(request.url);
+  if (url.origin !== self.location.origin) return;
+
+  // Audio uploads, transcripts and provider calls must always hit the network.
+  if (url.pathname.startsWith('/api/')) return;
+
+  if (request.mode === 'navigate') {
+    event.respondWith(handleNavigation(request));
+    return;
+  }
+
+  if (isStaticAsset(url)) {
+    event.respondWith(handleAsset(request));
+  }
+});
diff --git a/scripts/generate-icons.mjs b/scripts/generate-icons.mjs
new file mode 100644
index 0000000..15a35c2
--- /dev/null
+++ b/scripts/generate-icons.mjs
@@ -0,0 +1,97 @@
+/**
+ * scripts/generate-icons.mjs  ·  `npm run icons`
+ * ---------------------------------------------------------------------------
+ * Rasterises the app icon into the PNG sizes a PWA needs.
+ *
+ * The mark is a waveform inside a rounded square, drawn as SVG so it stays
+ * crisp at every size. `sharp` is already present as a Next.js dependency, so
+ * this adds nothing to the install.
+ *
+ * Outputs (all in public/icons/):
+ *   icon-192.png          home-screen icon
+ *   icon-512.png          store / splash icon
+ *   maskable-512.png      Android adaptive icon (extra safe padding)
+ *   apple-touch-icon.png  iOS home screen (opaque, 180px)
+ *   favicon-48.png        legacy browsers
+ */
+
+import { mkdir, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import sharp from 'sharp';
+
+const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+const outDir = path.join(root, 'public', 'icons');
+
+/** The waveform bars, in a 0–128 viewBox. */
+const BARS = [
+  [18, 36],
+  [34, 68],
+  [50, 92],
+  [66, 104],
+  [82, 76],
+  [98, 46],
+];
+
+/**
+ * @param {number} size    pixel size of the output
+ * @param {object} options
+ * @param {number} options.inset  how much of the canvas the mark occupies (0–1)
+ * @param {boolean} options.rounded  draw the rounded-square plate
+ */
+function iconSvg({ size, inset = 0.74, rounded = true }) {
+  const plate = rounded
+    ? `<rect width="128" height="128" rx="30" fill="url(#plate)"/>`
+    : `<rect width="128" height="128" fill="url(#plate)"/>`;
+
+  const bars = BARS.map(([x, height]) => {
+    const y = (128 - height) / 2;
+    return `<rect x="${x}" y="${y}" width="12" height="${height}" rx="6" fill="#ffffff" fill-opacity="0.94"/>`;
+  }).join('');
+
+  return `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 128 128" role="img" aria-label="Speech to Text Studio">
+  <defs>
+    <linearGradient id="plate" x1="0" y1="0" x2="128" y2="128" gradientUnits="userSpaceOnUse">
+      <stop offset="0" stop-color="#6f6cff"/>
+      <stop offset="0.55" stop-color="#5a4fe6"/>
+      <stop offset="1" stop-color="#3f2fb0"/>
+    </linearGradient>
+  </defs>
+  <g transform="translate(${(128 * (1 - inset)) / 2} ${(128 * (1 - inset)) / 2}) scale(${inset})">
+    ${plate}
+    ${bars}
+  </g>
+</svg>`;
+}
+
+async function render(name, size, options) {
+  const svg = Buffer.from(iconSvg({ size, ...options }));
+  const png = await sharp(svg, { density: 384 })
+    .resize(size, size, { fit: 'contain', background: { r: 0, g: 0, b: 0, alpha: 0 } })
+    .png({ compressionLevel: 9 })
+    .toBuffer();
+  await writeFile(path.join(outDir, name), png);
+  return `${name} (${(png.length / 1024).toFixed(1)} kB)`;
+}
+
+await mkdir(outDir, { recursive: true });
+
+const results = await Promise.all([
+  render('icon-192.png', 192),
+  render('icon-512.png', 512),
+  // Android masks the outer ~20% away, so the mark sits inside a smaller box.
+  render('maskable-512.png', 512, { inset: 0.6 }),
+  // iOS does not support transparency in home-screen icons.
+  render('apple-touch-icon.png', 180, { inset: 0.78, rounded: false }),
+  render('favicon-48.png', 48, { inset: 0.86 }),
+]);
+
+// Anchors the dir in git even if a generated file is ever removed.
+await writeFile(
+  path.join(outDir, '.gitkeep'),
+  'Icons are generated by `npm run icons` (scripts/generate-icons.mjs).\n',
+);
+
+// `warn` keeps the repo's no-console lint rule happy for build scripts.
+console.warn(`Icons written to public/icons:\n  ${results.join('\n  ')}`);
