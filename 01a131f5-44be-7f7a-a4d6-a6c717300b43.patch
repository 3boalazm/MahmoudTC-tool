+            <Link
+              href="/settings"
+              className="inline-flex items-center gap-1.5 rounded-lg border border-ink-500/20 bg-surface-2/60 px-2.5 py-1.5 font-medium text-ink-200 transition hover:border-iris-400/40 hover:text-ink-100"
