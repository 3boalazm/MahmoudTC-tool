index 0000000..6f9cafb
--- /dev/null
+++ b/tests/pwa.test.mjs
@@ -0,0 +1,122 @@
+/**
+ * tests/pwa.test.mjs
+ * ---------------------------------------------------------------------------
+ * The install story is easy to break silently: a manifest that stops being
+ * found, an icon that is missing or the wrong size, a service worker that
+ * starts caching transcripts. These checks run without a browser.
+ */
+
+import assert from 'node:assert/strict';
+import { existsSync, readFileSync, statSync } from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+const read = (relative) => readFileSync(path.join(root, relative), 'utf8');
+
+/* ---------------------------------------------------------------- manifest */
+
+const manifestSource = read('app/manifest.js');
+
+test('the manifest advertises everything an install needs', () => {
+  for (const field of [
+    'name',
+    'short_name',
+    'description',
+    'icons',
+    'start_url',
+    'display',
+    'background_color',
+    'theme_color',
+    'lang',
+    'dir',
+  ]) {
+    assert.match(manifestSource, new RegExp(`\\b${field}:`), `manifest.${field} is missing`);
+  }
+
+  assert.match(manifestSource, /'standalone'/, 'must install as a standalone window');
+  assert.match(manifestSource, /start_url: '\/studio/, 'the app should open on the studio');
+  assert.match(manifestSource, /shortcuts:/, 'long-press shortcuts are part of the install UX');
+});
+
+test('the manifest is localised from the same cookies as the pages', () => {
+  assert.match(manifestSource, /LOCALE_COOKIE|stt_locale/);
+  assert.match(manifestSource, /THEME_COOKIE|stt_theme/);
+  assert.match(manifestSource, /dirFor\(/, 'dir must follow the locale');
+  assert.match(manifestSource, /#f6f7fb/, 'light theme colour');
+  assert.match(manifestSource, /#070a13/, 'dark theme colour');
+});
+
+test('every declared icon exists, is a real PNG, and matches its declared size', () => {
+  const icons = [...manifestSource.matchAll(/src:\s*'([^']+)',\s*sizes:\s*'(\d+)x(\d+)'/g)];
+  assert.ok(icons.length >= 3, 'expected at least three icons');
+
+  const purposes = new Set();
+  for (const [, src, width, height] of icons) {
+    const file = path.join(root, 'public', src.replace(/^\//, ''));
+    assert.ok(existsSync(file), `${src} is referenced but missing`);
+
+    const bytes = readFileSync(file);
+    // PNG signature, then IHDR: width and height are big-endian uint32s.
+    assert.equal(bytes.subarray(0, 8).toString('hex'), '89504e470d0a1a0a', `${src} is not a PNG`);
+    assert.equal(bytes.readUInt32BE(16), Number(width), `${src} is ${bytes.readUInt32BE(16)}px wide`);
+    assert.equal(bytes.readUInt32BE(20), Number(height), `${src} has the wrong height`);
+    assert.ok(statSync(file).size > 1024, `${src} looks empty`);
+
+    for (const purpose of src.includes('maskable') ? ['maskable'] : ['any']) purposes.add(purpose);
+  }
+
+  assert.ok(purposes.has('maskable'), 'Android needs a maskable icon to avoid a white blob');
+  assert.ok(
+    icons.some(([, src]) => src.includes('192')) && icons.some(([, src]) => src.includes('512')),
+    'both 192px and 512px sizes are required',
+  );
+});
+
+/* --------------------------------------------------------- service worker */
+
+const sw = read('public/sw.js');
+
+test('the service worker is versioned and cleans up old caches', () => {
+  assert.match(sw, /const VERSION = '[^']+'/, 'the cache version must be bumped deliberately');
+  assert.match(sw, /stt-shell-\$\{VERSION\}/);
+  assert.match(sw, /stt-assets-\$\{VERSION\}/);
+  assert.match(sw, /keys\.filter\([\s\S]*?caches\.delete/, 'stale caches must be dropped');
+});
+
+test('the service worker precaches the shell, including /offline', () => {
+  const list = sw.slice(sw.indexOf('const SHELL_URLS'), sw.indexOf('\n];', sw.indexOf('const SHELL_URLS')));
+  assert.match(list, /'\/'/, 'the landing page is part of the shell');
+  assert.match(list, /'\/studio'/, 'the studio is the main app entry');
+  assert.match(list, /'\/offline'/, 'the offline fallback must be precached or it cannot work');
+  assert.ok(existsSync(path.join(root, 'app/offline/page.js')), 'the /offline route must exist');
+
+  // Every precached path must be a route (or static file) that ships.
+  for (const [, route] of list.matchAll(/'(\/[^']*)'/g)) {
+    // Static files are checked by the manifest test above.
+    if (route.includes('.')) continue;
+    const target = route === '/' ? 'app/page.js' : `app/${route.slice(1)}/page.js`;
+    assert.ok(existsSync(path.join(root, target)), `${route} is precached but ${target} does not exist`);
+  }
+});
+
+test('transcription requests are never served from the cache', () => {
+  assert.match(sw, /url\.pathname\.startsWith\('\/api\/'\)\)\s*return/, '/api/* must bypass the worker');
+  assert.match(sw, /request\.method !== 'GET'\)\s*return/, 'only GET is cacheable');
+  assert.ok(!/cache\.put\([^)]*\/api/.test(sw), 'nothing may write API responses into a cache');
+});
+
+test('navigations are network-first with /offline as the last resort', () => {
+  assert.match(sw, /mode === 'navigate'|request\.mode === 'navigate'/);
+  assert.match(sw, /caches\.match\('\/offline'\)/, 'a failed navigation must land on the offline page');
+  assert.match(sw, /self\.addEventListener\('fetch'/);
+  assert.match(sw, /self\.skipWaiting\(\)/, 'a new worker should take over immediately');
+});
+
+test('the worker is only registered in production', () => {
+  const registrar = read('components/ServiceWorkerRegistrar.js');
+  assert.match(registrar, /NODE_ENV !== 'production'|production/);
+  assert.match(registrar, /'\/sw\.js'/);
+  assert.match(registrar, /serviceWorker/);
+});
diff --git a/tests/theme.test.mjs b/tests/theme.test.mjs
new file mode 100644
index 0000000..056f79a
--- /dev/null
+++ b/tests/theme.test.mjs
@@ -0,0 +1,138 @@
+/**
+ * tests/theme.test.mjs
+ * ---------------------------------------------------------------------------
+ * The light theme is a *token* override, not a set of `dark:` variants. That
+ * only works if both palettes stay complete, so the central assertion here is
+ * that every colour token declared in `@theme` is re-declared under
+ * `[data-theme='light']` — miss one and a component silently keeps its dark
+ * value on a white page.
+ */
+
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync, statSync } from 'node:fs';
+import path from 'node:path';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+
+import { DEFAULT_THEME, THEME_COOKIE, THEMES } from '../lib/i18n/config.js';
+
+const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
+const css = readFileSync(path.join(root, 'app/globals.css'), 'utf8');
+
+/** Custom properties declared inside a CSS block. */
+function tokensIn(block) {
+  return [...block.matchAll(/--([a-z0-9-]+)\s*:/g)].map((match) => match[1]);
+}
+
+function block(startingAt, source = css) {
+  const start = source.indexOf(startingAt);
+  assert.ok(start !== -1, `${startingAt} not found in globals.css`);
+  const end = source.indexOf('\n}', start);
+  assert.ok(end !== -1, `${startingAt} is not closed`);
+  return source.slice(start, end);
+}
+
+const baseTokens = tokensIn(block('@theme'));
+const lightTokens = tokensIn(block("[data-theme='light'] {"));
+
+test('the dark palette is declared as Tailwind theme tokens', () => {
+  assert.ok(baseTokens.length >= 20, `expected a full palette, found ${baseTokens.length}`);
+  assert.ok(baseTokens.includes('color-canvas'), 'the canvas token is the base surface');
+  assert.ok(baseTokens.includes('color-ink-100'), 'the ink ramp drives all text');
+  assert.ok(
+    baseTokens.some((token) => token.startsWith('color-iris')) ||
+      baseTokens.some((token) => token.startsWith('color-accent')),
+    'an accent ramp must exist',
+  );
+});
+
+test('every colour token is re-declared for the light theme', () => {
+  const colours = baseTokens.filter((token) => token.startsWith('color-') || token.startsWith('shadow-'));
+  const missing = colours.filter((token) => !lightTokens.includes(token));
+  assert.deepEqual(missing, [], `light theme is missing: ${missing.join(', ')}`);
+
+  const strays = lightTokens.filter((token) => !colours.includes(token));
+  assert.deepEqual(strays, [], `light theme declares unknown tokens: ${strays.join(', ')}`);
+});
+
+test('the light palette is genuinely light and the dark palette genuinely dark', () => {
+  const luminance = (hex) => {
+    const value = hex.replace('#', '');
+    const [r, g, b] = [0, 2, 4].map((i) => parseInt(value.slice(i, i + 2), 16));
+    return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
+  };
+
+  const canvas = (source) => source.match(/--color-canvas:\s*(#[0-9a-fA-F]{6})/)[1];
+  const lightCanvas = canvas(block("[data-theme='light'] {"));
+  const darkCanvas = canvas(block('@theme'));
+
+  assert.ok(luminance(lightCanvas) > 0.85, `light canvas ${lightCanvas} is not light enough`);
+  assert.ok(luminance(darkCanvas) < 0.15, `dark canvas ${darkCanvas} is not dark enough`);
+
+  // The ink ramps must invert: dark text on the light canvas, light text on the dark one.
+  const lightInk = lightTokens.includes('color-ink-100');
+  assert.ok(lightInk, 'light theme must restate the ink ramp');
+});
+
+test('no component hard-codes a palette colour', () => {
+  const files = [];
+  const walk = (dir) => {
+    for (const entry of readdirSync(dir)) {
+      if (entry === 'node_modules' || entry.startsWith('.')) continue;
+      const full = path.join(dir, entry);
+      if (statSync(full).isDirectory()) walk(full);
+      else if (/\.(?:js|mjs)$/.test(entry)) files.push(full);
+    }
+  };
+  walk(path.join(root, 'app'));
+  walk(path.join(root, 'components'));
+
+  const offenders = [];
+  for (const file of files) {
+    const source = readFileSync(file, 'utf8');
+    // Hex colours are only allowed where a browser API needs a literal string
+    // (meta theme-color, the manifest) — never inside a className.
+    for (const match of source.matchAll(/className=(?:"([^"]*)"|\{`([^`]*)`\})/g)) {
+      const value = match[1] ?? match[2] ?? '';
+      if (/#[0-9a-fA-F]{3,8}\b/.test(value)) {
+        offenders.push(`${path.relative(root, file)}: ${value.slice(0, 60)}`);
+      }
+    }
+  }
+  assert.deepEqual(offenders, [], `components must use theme tokens, found:\n${offenders.join('\n')}`);
+});
+
+/* ------------------------------------------------------------------ cookie */
+
+test('the theme cookie contract is explicit', () => {
+  assert.equal(THEME_COOKIE, 'stt_theme');
+  assert.deepEqual(THEMES, ['system', 'light', 'dark']);
+  assert.equal(DEFAULT_THEME, 'system', 'a first-time visitor should follow the OS');
+});
+
+test('the server bakes an explicit preference into the HTML', () => {
+  const layout = readFileSync(path.join(root, 'app/layout.js'), 'utf8');
+  assert.match(layout, /data-theme-preference=\{theme\}/);
+  assert.match(
+    layout,
+    /data-theme=\{theme === 'system' \? undefined : theme\}/,
+    'light/dark must be server-rendered so no-JS visitors get the right palette',
+  );
+  assert.match(layout, /THEME_SCRIPT/, 'system still needs the pre-paint script');
+});
+
+test('the toggle cycles through every theme', () => {
+  const toggle = readFileSync(path.join(root, 'components/layout/ThemeToggle.js'), 'utf8');
+  for (const theme of THEMES) {
+    assert.match(toggle, new RegExp(`'${theme}'`), `the toggle cannot reach "${theme}"`);
+  }
+  assert.match(toggle, /setTheme\(/, 'the toggle must write through the provider');
+});
+
+test('the pre-paint script writes the attributes the CSS reacts to', () => {
+  const provider = readFileSync(path.join(root, 'components/providers/ThemeProvider.js'), 'utf8');
+  const script = provider.slice(provider.indexOf('export const THEME_SCRIPT'));
+  assert.match(script, /setAttribute\('data-theme'/, 'CSS keys off data-theme');
+  assert.match(script, /data-theme-preference/);
+  assert.match(script, /colorScheme/);
+});
