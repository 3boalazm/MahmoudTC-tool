+    ...result,
+    engine: 'deepgram',
+    model: config.model || DEEPGRAM_DEFAULT_MODEL,
+    requestId:
+      payload?.metadata?.request_id ?? response.headers.get('dg-request-id') ?? null,
+    elapsedMs: Date.now() - startedAt,
